---
interface Props {
  class?: string;
  density?: number;
  connect?: boolean;
}

const { class: className = '', density = 9000, connect = true } = Astro.props;
---

<canvas
  class:list={['ambient', className]}
  data-ambient
  data-density={density}
  data-connect={connect ? '1' : '0'}
  aria-hidden="true"></canvas>

<style>
  .ambient {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient {
      opacity: 0.55;
    }
  }
</style>

<script>
  type Node = { x: number; y: number; vx: number; vy: number; ox: number; oy: number };

  const instances: Array<() => void> = [];

  function readColor(name: string): string {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }

  function start(canvas: HTMLCanvasElement): () => void {
    const ctx = canvas.getContext('2d');
    if (!ctx) return () => {};

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const density = Number(canvas.dataset.density) || 9000;
    const connect = canvas.dataset.connect === '1';

    let nodes: Node[] = [];
    let w = 0;
    let h = 0;
    let dpr = 1;
    let raf: number | null = null;
    let visible = true;
    const pointer = { x: -9999, y: -9999 };
    let dot = '#000';
    let line = '#000';
    let live = '#000';

    const palette = () => {
      dot = readColor('--border-strong');
      line = readColor('--border');
      live = readColor('--accent');
    };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width;
      h = rect.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const target = Math.min(120, Math.max(24, Math.round((w * h) / density)));
      const cols = Math.ceil(Math.sqrt(target * (w / Math.max(h, 1))));
      const rows = Math.ceil(target / Math.max(cols, 1));
      nodes = [];
      for (let r = 0; r <= rows; r++) {
        for (let c = 0; c <= cols; c++) {
          const jx = ((c * 37 + r * 11) % 13) / 13 - 0.5;
          const jy = ((r * 29 + c * 7) % 11) / 11 - 0.5;
          const x = ((c + 0.5) / (cols + 1)) * w + jx * 18;
          const y = ((r + 0.5) / (rows + 1)) * h + jy * 18;
          nodes.push({ x, y, ox: x, oy: y, vx: 0, vy: 0 });
        }
      }
    };

    const draw = (t: number) => {
      ctx.clearRect(0, 0, w, h);

      for (const n of nodes) {
        if (!reduced) {
          const drift = Math.sin(t / 3100 + n.ox * 0.017) * 7 + Math.cos(t / 6700 + n.oy * 0.009) * 3;
          const driftY = Math.cos(t / 3800 + n.oy * 0.015) * 7 + Math.sin(t / 7300 + n.ox * 0.011) * 3;
          const dx = n.x - pointer.x;
          const dy = n.y - pointer.y;
          const d2 = dx * dx + dy * dy;
          const reach = 130;

          if (d2 < reach * reach) {
            const d = Math.max(Math.sqrt(d2), 1);
            const push = (1 - d / reach) * 16;
            n.vx += (dx / d) * push * 0.06;
            n.vy += (dy / d) * push * 0.06;
          }

          const tx = n.ox + drift;
          const ty = n.oy + driftY;
          n.vx += (tx - n.x) * 0.012;
          n.vy += (ty - n.y) * 0.012;
          n.vx *= 0.88;
          n.vy *= 0.88;
          n.x += n.vx;
          n.y += n.vy;
        }

        const dxp = n.x - pointer.x;
        const dyp = n.y - pointer.y;
        const near = Math.sqrt(dxp * dxp + dyp * dyp) < 150;

        ctx.beginPath();
        ctx.arc(n.x, n.y, near ? 2 : 1.5, 0, Math.PI * 2);
        ctx.fillStyle = near ? live : dot;
        ctx.globalAlpha = near ? 0.6 : 0.95;
        ctx.fill();
      }

      if (connect) {
        ctx.globalAlpha = 0.7;
        ctx.strokeStyle = line;
        ctx.lineWidth = 1;
        for (let i = 0; i < nodes.length; i++) {
          for (let j = i + 1; j < nodes.length; j++) {
            const a = nodes[i];
            const b = nodes[j];
            const dx = a.x - b.x;
            const dy = a.y - b.y;
            const d2 = dx * dx + dy * dy;
            if (d2 > 130 * 130) continue;
            ctx.globalAlpha = 0.72 * (1 - Math.sqrt(d2) / 130);
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
      }

      ctx.globalAlpha = 1;
    };

    const loop = (t: number) => {
      draw(t);
      raf = reduced ? null : requestAnimationFrame(loop);
    };

    const play = () => {
      if (raf === null && visible && !reduced) raf = requestAnimationFrame(loop);
    };
    const pause = () => {
      if (raf !== null) cancelAnimationFrame(raf);
      raf = null;
    };

    const onPointer = (e: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      pointer.x = e.clientX - rect.left;
      pointer.y = e.clientY - rect.top;
      if (reduced) draw(performance.now());
    };
    const onLeave = () => {
      pointer.x = -9999;
      pointer.y = -9999;
    };

    palette();
    resize();
    draw(performance.now());
    play();

    const io = new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      visible ? play() : pause();
    });
    io.observe(canvas);

    const ro = new ResizeObserver(() => {
      resize();
      draw(performance.now());
    });
    ro.observe(canvas);

    const themeWatch = new MutationObserver(() => {
      palette();
      draw(performance.now());
    });
    themeWatch.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    window.addEventListener('pointermove', onPointer, { passive: true });
    window.addEventListener('blur', pause);
    window.addEventListener('focus', play);
    document.addEventListener('pointerleave', onLeave);

    return () => {
      pause();
      io.disconnect();
      ro.disconnect();
      themeWatch.disconnect();
      window.removeEventListener('pointermove', onPointer);
      window.removeEventListener('blur', pause);
      window.removeEventListener('focus', play);
      document.removeEventListener('pointerleave', onLeave);
    };
  }

  function initAmbient() {
    while (instances.length) instances.pop()?.();
    document.querySelectorAll<HTMLCanvasElement>('[data-ambient]').forEach((c) => {
      instances.push(start(c));
    });
  }

  document.addEventListener('astro:page-load', initAmbient);
  document.addEventListener('astro:before-swap', () => {
    while (instances.length) instances.pop()?.();
  });
</script>
