---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  magnetic?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  magnetic = false,
  class: className = '',
  ...rest
} = Astro.props;

const classes = ['btn', variant === 'primary' ? 'btn-primary' : 'btn-secondary', className]
  .filter(Boolean)
  .join(' ');

const magAttr = magnetic ? { 'data-magnetic': '0.35' } : {};
const Tag = href ? 'a' : 'button';
---

<Tag class={classes} href={href} {...magAttr} {...rest}>
  <slot />
</Tag>
