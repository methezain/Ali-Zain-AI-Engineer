---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'sm';
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'primary', size = 'md', class: className = '', ...rest } = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn-${variant}`, { 'btn-sm': size === 'sm' }, className]}
  href={href}
  type={href ? undefined : 'button'}
  {...rest}
>
  <slot />
</Tag>
