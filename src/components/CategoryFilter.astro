---
interface Cat {
  name: string;
  slug: string;
  count?: number;
}
interface Props {
  categories: Cat[];
  // Active category slug, or null when viewing "All".
  active?: string | null;
}
const { categories, active = null } = Astro.props;
---

<nav class="filters" aria-label="Filter posts by category">
  <a class:list={['filter', { 'is-active': active === null }]} href="/blog" aria-current={active === null ? 'page' : undefined}>
    All
  </a>
  {
    categories.map((c) => (
      <a
        class:list={['filter', { 'is-active': active === c.slug }]}
        href={`/blog/category/${c.slug}`}
        aria-current={active === c.slug ? 'page' : undefined}
      >
        {c.name}
      </a>
    ))
  }
</nav>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }
  .filter {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .filter:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .filter.is-active {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
</style>
