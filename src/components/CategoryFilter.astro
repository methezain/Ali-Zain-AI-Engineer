---
interface Cat {
  name: string;
  slug: string;
  count?: number;
}
interface Props {
  categories: Cat[];
  // Active category slug, or null when viewing "All".
  active?: string | null;
}
const { categories, active = null } = Astro.props;
---

<nav class="filters" aria-label="Filter posts by category">
  <a class:list={['filter', { 'is-active': active === null }]} href="/blog" aria-current={active === null ? 'page' : undefined}>
    All
  </a>
  {
    categories.map((c) => (
      <a
        class:list={['filter', { 'is-active': active === c.slug }]}
        href={`/blog/category/${c.slug}`}
        aria-current={active === c.slug ? 'page' : undefined}
      >
        {c.name}
      </a>
    ))
  }
</nav>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .filter {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.9375rem;
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--text-2);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.85rem;
    transition:
      background-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      transform var(--dur-press) var(--spring-ui);
  }

  .filter:hover {
    color: var(--text-1);
    background: var(--surface-2);
  }

  .filter:active {
    transform: scale(0.97);
  }

  .filter.is-active {
    background: var(--surface-1);
    border-color: var(--border);
    box-shadow: var(--shadow-card);
    color: var(--text-1);
  }
</style>
