---
import { Icon } from 'astro-icon/components';
import { site, nav } from '../config/site';
const year = new Date().getFullYear();
const footerNav = nav.filter((item) => !['/', '/about'].includes(item.href));

const socials = [
  { name: 'GitHub', href: site.social.github, icon: 'simple-icons:github' },
  { name: 'LinkedIn', href: site.social.linkedin, icon: 'simple-icons:linkedin' },
  { name: 'Instagram', href: site.social.instagram, icon: 'simple-icons:instagram' },
  { name: 'X', href: site.social.x, icon: 'simple-icons:x' },
  { name: 'Medium', href: site.social.medium, icon: 'medium' },
];

const mediumSvg =
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.54 12a6.8 6.8 0 0 1-6.77 6.82A6.8 6.8 0 0 1 0 12a6.8 6.8 0 0 1 6.77-6.82A6.8 6.8 0 0 1 13.54 12m7.42 0c0 3.54-1.51 6.42-3.38 6.42s-3.39-2.88-3.39-6.42 1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75S21.62 15.17 21.62 12s.53-5.75 1.19-5.75S24 8.83 24 12"/></svg>';
---

<footer class="site-footer">
  <div class="container-site">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        {
          site.available && (
            <span class="status-pill">
              <span class="status-pill__dot" aria-hidden="true" />
              Available for work
            </span>
          )
        }
        <p class="site-footer__tagline">
          AI systems that remove real work, from retrieval and document pipelines to trained supervised models.
        </p>
        <a href="/contact" class="btn btn-secondary btn-sm site-footer__cta">
          Start a project
          <Icon name="lucide:arrow-right" width={15} height={15} />
        </a>
      </div>

      <nav class="site-footer__col" aria-label="Footer">
        <h2 class="footer-heading mono-label">Pages</h2>
        <ul class="footer-list">
          {footerNav.map((item) => <li><a href={item.href} class="footer-link">{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="footer-heading mono-label">Contact</h2>
        <ul class="footer-list">
          <li><a href={`mailto:${site.email}`} class="footer-link">{site.email}</a></li>
          <li>
            <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="footer-link">{site.phone}</a>
          </li>
        </ul>
      </div>

      <div class="site-footer__col">
        <h2 class="footer-heading mono-label">Elsewhere</h2>
        <ul class="social-row">
          {
            socials.map((s) => (
              <li>
                <a
                  class:list={['social-icon', { 'social-icon--medium': s.name === 'Medium' }]}
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={s.name}
                >
                  <span class="social-icon__base" aria-hidden="true">
                    {s.icon === 'medium' ? (
                      <Fragment set:html={mediumSvg} />
                    ) : (
                      <Icon name={s.icon} width={20} height={20} />
                    )}
                  </span>
                  <span class="social-icon__fill" aria-hidden="true">
                    {s.icon === 'medium' ? (
                      <Fragment set:html={mediumSvg} />
                    ) : (
                      <Icon name={s.icon} width={20} height={20} />
                    )}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>© {year} {site.name}. All rights reserved.</span>
      <a href="#main" class="footer-top-link">
        Back to top
        <Icon name="lucide:arrow-up" width={13} height={13} />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-2);
    border-top: 1px solid var(--border);
    padding: clamp(2.5rem, 4.5vw, 3.5rem) 0 1.5rem;
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-strong);
  }

  .site-footer__tagline {
    max-width: 34ch;
    margin: 1.125rem 0 1.5rem;
    color: var(--text-2);
    font-size: 1rem;
  }

  .site-footer__cta {
    background: var(--surface-1);
  }

  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .footer-heading {
    margin: 0;
    color: var(--text-3);
  }

  .footer-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    font-size: 0.9375rem;
    color: var(--text-2);
    transition: color var(--dur-1) var(--ease-out);
  }

  .footer-link:hover {
    color: var(--text-1);
  }

  .footer-link:active {
    color: var(--accent-hover);
  }

  .footer-top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-3);
    transition: color var(--dur-1) var(--ease-out);
  }

  .footer-top-link:hover {
    color: var(--accent);
  }

  .social-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0.125rem 0 0;
  }

  .social-icon {
    position: relative;
    display: inline-flex;
    width: 20px;
    height: 20px;
  }

  .social-icon--medium svg {
    transform: scale(1.4);
    transform-origin: center;
  }

  .social-icon__base,
  .social-icon__fill {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .social-icon__base {
    color: var(--text-2);
  }

  .social-icon__fill {
    color: var(--accent);
    clip-path: inset(0 100% 0 0);
    transition: clip-path var(--dur-3) var(--ease-out);
  }

  .social-icon:hover .social-icon__fill,
  .social-icon:focus-visible .social-icon__fill {
    clip-path: inset(0 0 0 0);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: space-between;
    align-items: baseline;
    padding-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--text-3);
  }

  @media (min-width: 720px) {
    .site-footer__top {
      grid-template-columns: minmax(0, 1fr) auto auto auto;
      column-gap: clamp(2.5rem, 6vw, 5.5rem);
      row-gap: 2rem;
    }
  }
</style>
