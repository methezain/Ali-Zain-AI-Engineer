---
// A pulsing "Live" indicator for shipped projects.
// - With `href`: renders a link that opens the live project in a new tab.
// - Without `href`: renders a static badge (safe to nest inside a card link).
import { Icon } from 'astro-icon/components';

interface Props {
  href?: string;
  label?: string;
  class?: string;
}

const { href, label = 'Live', class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
const linkAttrs = href
  ? { href, target: '_blank', rel: 'noopener noreferrer', 'data-cursor': 'view' }
  : {};
---

<Tag class:list={['live-badge', { 'live-badge--link': !!href }, className]} {...linkAttrs}>
  <span class="live-badge__dot" aria-hidden="true"></span>
  <span class="live-badge__label">{label}</span>
  {
    href && (
      <span class="live-badge__arrow" aria-hidden="true">
        <Icon name="lucide:arrow-up-right" width={13} height={13} />
      </span>
    )
  }
</Tag>

<style>
  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.7rem 0.3rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 8%, var(--surface));
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    white-space: nowrap;
    line-height: 1;
  }

  .live-badge--link {
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .live-badge--link:hover {
    background: color-mix(in srgb, var(--accent) 14%, var(--surface));
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .live-badge--link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .live-badge__dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  /* Diagonal arrow signals the badge opens the live site in a new tab. */
  .live-badge__arrow {
    display: inline-flex;
    flex: none;
    margin-left: -0.05rem;
    transition: transform 0.2s ease;
  }
  .live-badge--link:hover .live-badge__arrow {
    transform: translate(1.5px, -1.5px);
  }
  @media (prefers-reduced-motion: reduce) {
    .live-badge__arrow {
      transition: none;
    }
  }
  /* Expanding ring pulse. */
  .live-badge__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: live-ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes live-ping {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-badge__dot::after {
      animation: none;
    }
  }
</style>
