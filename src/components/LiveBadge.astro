---
import { Icon } from 'astro-icon/components';

interface Props {
  href?: string;
  label?: string;
  class?: string;
}

const { href, label = 'Live', class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
const linkAttrs = href ? { href, target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Tag class:list={['status-pill', 'live-badge', { 'live-badge--link': !!href }, className]} {...linkAttrs}>
  <span class="status-pill__dot" aria-hidden="true"></span>
  <span>{label}</span>
  {
    href && (
      <span class="live-badge__arrow" aria-hidden="true">
        <Icon name="lucide:arrow-up-right" width={13} height={13} />
      </span>
    )
  }
</Tag>

<style>
  .live-badge--link {
    transition:
      background-color var(--dur-1) var(--ease-out),
      transform var(--dur-press) var(--spring-ui);
  }

  .live-badge--link:hover {
    background: var(--surface-3);
  }

  .live-badge--link:active {
    transform: scale(0.96);
  }

  .live-badge__arrow {
    display: inline-flex;
    margin-left: -0.1rem;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .live-badge--link:hover .live-badge__arrow {
    transform: translate(1.5px, -1.5px);
  }
</style>
