---
import { Icon } from 'astro-icon/components';
import { site, nav } from '../config/site';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header id="site-header" class="site-header">
  <div class="container-site site-header__inner">
    <a href="/" class="wordmark" aria-label={`${site.name}, home`}>
      Ali&nbsp;Zain<span class="wordmark__dot">.</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header__actions">
      <a href="/contact" class="btn btn-primary site-header__cta" data-magnetic="0.35">
        Start a project
      </a>
      <button
        id="menu-toggle"
        class="menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="lucide:menu" width={24} height={24} />
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" aria-hidden="true">
  <nav class="mobile-menu__nav" aria-label="Mobile">
    {
      nav.map((item, i) => (
        <a href={item.href} class="mobile-menu__link" style={`--i:${i}`}>
          {item.label}
        </a>
      ))
    }
  </nav>
</div>

<noscript>
  <nav class="noscript-nav" aria-label="Primary no script">
    <div class="container-site noscript-nav__inner">
      {
        nav.map((item) => (
          <a href={item.href} class="noscript-nav__link">
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</noscript>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s ease;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--border);
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .wordmark {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .wordmark__dot {
    color: var(--accent);
  }

  .site-nav {
    display: none;
    gap: 2rem;
  }

  .site-nav__link {
    position: relative;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    padding: 0.25rem 0;
    transition: color 0.15s ease;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-nav__link:hover::after,
  .site-nav__link.is-active::after {
    transform: scaleX(1);
  }

  .site-nav__link.is-active {
    color: var(--accent);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-header__cta {
    display: none;
    min-height: 40px;
    padding: 0.5rem 1.125rem;
    font-size: 0.9rem;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--ink);
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 99;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .mobile-menu.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
  }

  .mobile-menu__link {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(2rem, 9vw, 3rem);
    color: var(--ink);
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
    transition-delay: calc(var(--i) * 60ms);
  }

  .mobile-menu.is-open .mobile-menu__link {
    opacity: 1;
    transform: translateY(0);
  }

  .noscript-nav {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  .noscript-nav__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.25rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }
  .noscript-nav__link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
  }

  @media (min-width: 860px) {
    .site-nav {
      display: flex;
    }
    .site-header__cta {
      display: inline-flex;
    }
    .menu-toggle {
      display: none;
    }
  }
</style>

<script>
  let headerCleanup: (() => void) | null = null;

  function initHeader() {
    // Tear down any previous instance to avoid duplicate listeners
    // (astro:page-load fires on first load too, so this runs cleanly once).
    headerCleanup?.();

    const header = document.getElementById('site-header');
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!header || !toggle || !menu) return;

    // Hide-on-scroll-down / reveal-on-scroll-up + scrolled border.
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      header.classList.toggle('is-scrolled', y > 8);
      if (y > lastY && y > 200 && !menu.classList.contains('is-open')) {
        header.classList.add('is-hidden');
      } else {
        header.classList.remove('is-hidden');
      }
      lastY = y;
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    const setOpen = (open: boolean) => {
      menu.classList.toggle('is-open', open);
      menu.setAttribute('aria-hidden', String(!open));
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.style.overflow = open ? 'hidden' : '';
    };

    const onToggle = () => setOpen(!menu.classList.contains('is-open'));
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') setOpen(false);
    };
    const onLinkClick = () => setOpen(false);

    toggle.addEventListener('click', onToggle);
    document.addEventListener('keydown', onKey);
    const links = menu.querySelectorAll('a');
    links.forEach((a) => a.addEventListener('click', onLinkClick));

    headerCleanup = () => {
      window.removeEventListener('scroll', onScroll);
      document.removeEventListener('keydown', onKey);
      toggle.removeEventListener('click', onToggle);
      links.forEach((a) => a.removeEventListener('click', onLinkClick));
      document.body.style.overflow = '';
    };
  }

  // Only bind on astro:page-load — it fires on the initial load and after
  // every View Transition, so a single handler avoids double-binding.
  document.addEventListener('astro:page-load', initHeader);
</script>
