---
import { Icon } from 'astro-icon/components';
import { site, nav } from '../config/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header id="site-header" class="site-header" data-translucent>
  <div class="container-site site-header__inner">
    <a href="/" class="wordmark" aria-label={`${site.name}, home`}>
      Ali&nbsp;Zain<span class="wordmark__tld">.dev</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header__actions">
      <button id="theme-toggle" class="icon-btn" type="button" aria-label="Switch theme">
        <span class="icon-btn__sun"><Icon name="lucide:sun" width={18} height={18} /></span>
        <span class="icon-btn__moon"><Icon name="lucide:moon" width={18} height={18} /></span>
      </button>
      <a href="/contact" class="btn btn-secondary btn-sm site-header__cta">Start a project</a>
      <button
        id="menu-toggle"
        class="icon-btn menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-toggle__open"><Icon name="lucide:menu" width={20} height={20} /></span>
        <span class="menu-toggle__close"><Icon name="lucide:x" width={20} height={20} /></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" hidden>
  <div class="container-site mobile-menu__inner">
    <nav class="mobile-menu__nav" aria-label="Mobile">
      {
        nav.map((item, i) => (
          <a
            href={item.href}
            class:list={['mobile-menu__link', { 'is-active': isActive(item.href) }]}
            style={`--i:${i}`}
          >
            <span class="index-marker">{String(i + 1).padStart(2, '0')}</span>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="mobile-menu__foot">
      <a href="/contact" class="btn btn-primary mobile-menu__cta">Start a project</a>
      <a href={`mailto:${site.email}`} class="mono-label mobile-menu__mail">{site.email}</a>
    </div>
  </div>
</div>

<noscript>
  <nav class="noscript-nav" aria-label="Primary no script">
    <div class="container-site noscript-nav__inner">
      {nav.map((item) => <a href={item.href} class="noscript-nav__link">{item.label}</a>)}
    </div>
  </nav>
</noscript>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(18px) saturate(180%);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    height: 68px;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.022em;
    color: var(--text-1);
    white-space: nowrap;
  }

  .wordmark__tld {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.8125rem;
    letter-spacing: 0;
    color: var(--text-3);
  }

  .site-nav {
    display: none;
    gap: 1.75rem;
  }

  .site-nav__link {
    position: relative;
    font-size: 0.9rem;
    font-weight: 450;
    color: var(--text-2);
    padding: 0.375rem 0;
    transition: color var(--dur-1) var(--ease-out);
  }

  .site-nav__link:hover {
    color: var(--text-1);
  }

  .site-nav__link.is-active {
    color: var(--text-1);
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .site-nav__link.is-active::after {
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--r-control);
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out),
      transform var(--dur-press) var(--spring-ui);
  }

  .icon-btn:hover {
    background: var(--surface-2);
    color: var(--text-1);
  }

  .icon-btn:active {
    transform: scale(0.92);
  }

  .icon-btn__sun,
  .icon-btn__moon,
  .menu-toggle__open,
  .menu-toggle__close {
    display: inline-flex;
  }

  :global([data-theme='light']) .icon-btn__sun,
  :global([data-theme='dark']) .icon-btn__moon {
    display: none;
  }

  .site-header__cta {
    display: none;
    margin-left: 0.25rem;
  }

  .menu-toggle .menu-toggle__close {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__open {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__close {
    display: inline-flex;
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: var(--bg);
    padding-top: 68px;
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu.is-open {
    opacity: 1;
    transform: none;
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-6);
    min-height: calc(100% - 68px);
    padding-block: var(--s-6) var(--s-7);
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
  }

  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 8vw, 2.25rem);
    letter-spacing: -0.03em;
    color: var(--text-1);
    padding: 0.6875rem 0;
    border-bottom: 1px solid var(--border);
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out),
      color var(--dur-1) var(--ease-out);
    transition-delay: calc(var(--i) * 35ms);
  }

  .mobile-menu.is-open .mobile-menu__link {
    opacity: 1;
    transform: none;
  }

  .mobile-menu__link.is-active {
    color: var(--accent);
  }

  .mobile-menu__link:active {
    color: var(--accent);
  }

  .mobile-menu__foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
    padding-top: var(--s-6);
  }

  .mobile-menu__cta {
    width: 100%;
  }

  .mobile-menu__mail {
    color: var(--text-2);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .noscript-nav {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .noscript-nav__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.25rem;
    padding-block: 0.75rem;
  }

  .noscript-nav__link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-1);
  }

  @media (min-width: 900px) {
    .site-nav {
      display: flex;
    }
    .site-header__cta {
      display: inline-flex;
    }
    .menu-toggle {
      display: none;
    }
  }
</style>

<script>
  const FOCUSABLE = 'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

  let cleanup: (() => void) | null = null;

  function initHeader() {
    cleanup?.();

    const header = document.getElementById('site-header');
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const themeBtn = document.getElementById('theme-toggle');
    if (!header || !toggle || !menu || !themeBtn) return;

    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const labelTheme = () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      themeBtn.setAttribute('aria-label', `Switch to ${next} theme`);
    };
    labelTheme();

    const onTheme = () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
      labelTheme();
    };
    themeBtn.addEventListener('click', onTheme);

    const inert = [document.getElementById('main'), document.querySelector('footer')];
    let open = false;

    const setOpen = (next: boolean) => {
      open = next;
      toggle.setAttribute('aria-expanded', String(next));
      toggle.setAttribute('aria-label', next ? 'Close menu' : 'Open menu');
      document.body.style.overflow = next ? 'hidden' : '';
      inert.forEach((el) => el && (next ? el.setAttribute('inert', '') : el.removeAttribute('inert')));

      if (next) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('is-open'));
        menu.querySelector<HTMLElement>(FOCUSABLE)?.focus();
      } else {
        menu.classList.remove('is-open');
        const done = () => {
          if (!open) menu.hidden = true;
        };
        setTimeout(done, 240);
        toggle.focus();
      }
    };

    const onToggle = () => setOpen(!open);
    const onKey = (e: KeyboardEvent) => {
      if (!open) return;
      if (e.key === 'Escape') {
        setOpen(false);
        return;
      }
      if (e.key !== 'Tab') return;
      const items = Array.from(menu.querySelectorAll<HTMLElement>(FOCUSABLE));
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };
    const onLink = () => setOpen(false);

    toggle.addEventListener('click', onToggle);
    document.addEventListener('keydown', onKey);
    const links = Array.from(menu.querySelectorAll('a'));
    links.forEach((a) => a.addEventListener('click', onLink));

    cleanup = () => {
      window.removeEventListener('scroll', onScroll);
      document.removeEventListener('keydown', onKey);
      toggle.removeEventListener('click', onToggle);
      themeBtn.removeEventListener('click', onTheme);
      links.forEach((a) => a.removeEventListener('click', onLink));
      document.body.style.overflow = '';
      inert.forEach((el) => el?.removeAttribute('inert'));
    };
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
