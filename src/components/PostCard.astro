---
import type { CollectionEntry } from 'astro:content';
import LiveBadge from './LiveBadge.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { data } = entry;
const href = `/blog/${entry.slug}`;
const title = data.cardTitle ?? data.title;
// Cards display small, so use the ~600px variant to keep downloads tiny.
const cardImg = data.image.replace(/\.webp$/, '-sm.webp');
---

<a class="post-card card card-interactive" href={href} data-category={data.category}>
  <div class="post-card__media">
    <img
      src={cardImg}
      alt={data.imageAlt}
      width="600"
      height="400"
      loading="lazy"
      decoding="async"
    />
    {(data.liveUrl || data.liveLinks?.length) && (
      <span class="post-card__live">
        <LiveBadge />
      </span>
    )}
  </div>
  <div class="post-card__body">
    <span class="post-card__cat">{data.category}</span>
    <h3>{title}</h3>
    <p>{data.excerpt}</p>
    <ul class="tags">
      {data.tags.slice(0, 3).map((t) => <li>{t}</li>)}
    </ul>
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    height: 100%;
  }

  .post-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }

  .post-card__live {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 1;
    display: inline-flex;
  }

  .post-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .post-card:hover .post-card__media img {
    transform: scale(1.03);
  }

  .post-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.5rem;
    padding: 1.125rem 1.125rem 1.25rem;
  }

  .post-card__cat {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-3);
  }

  .post-card__body h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  .post-card__body p {
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.55;
    margin: 0;
  }

  .post-card__body .tags {
    margin-top: auto;
    padding-top: 0.75rem;
  }
</style>
