---
import { Icon } from 'astro-icon/components';

const readout = [
  { k: 'model', v: 'YOLOv8 + FaceMesh' },
  { k: 'tracks', v: 'Stable ID per student' },
  { k: 'states', v: 'Attentive · Distracted · Asleep' },
  { k: 'output', v: 'Per frame counts, session summary' },
];
---

<div class="vis">
  <div class="vis__rail">
    <span class="mono-label vis__tag">
      <span class="vis__dot" aria-hidden="true"></span>
      Live model output
    </span>
    <span class="mono vis__file">student_behavior_analysis.mp4</span>
  </div>

  <figure class="vis__frame">
    <video
      class="vis__video"
      poster="/student-behavior-poster.webp"
      width="1280"
      height="720"
      muted
      loop
      playsinline
      preload="none"
      aria-label="Classroom video with the model drawing a box and a face mesh over each student and labelling their attention state"
    >
      <source src="/student-behavior-analysis.mp4" type="video/mp4" />
    </video>

    <button class="vis__toggle" type="button" data-vis-toggle aria-pressed="false">
      <Icon class="vis__icon vis__icon--play" name="lucide:play" width={15} height={15} />
      <Icon class="vis__icon vis__icon--pause" name="lucide:pause" width={15} height={15} />
      <span class="vis__toggle-text">Play</span>
    </button>

    <span class="vis__corner vis__corner--tl" aria-hidden="true"></span>
    <span class="vis__corner vis__corner--br" aria-hidden="true"></span>
  </figure>

  <div class="vis__body">
    <div class="vis__copy">
      <h2>Attention, per student, per frame.</h2>
      <p>
        A classroom camera, forty students, and a model that boxes every face, fits a mesh to it,
        and decides whether that student is following the lesson. Nobody is counted twice, the
        state holds across frames, and the teacher gets a session summary instead of a hunch.
      </p>
      <p class="vis__aside">
        The same detection stack, pointed at a different problem, tracks players on an indoor
        squash court.
      </p>
    </div>

    <dl class="vis__readout">
      {
        readout.map((r) => (
          <div class="vis__row">
            <dt class="mono-label">{r.k}</dt>
            <dd class="mono">{r.v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</div>

<script>
  const boot = () => {
    document.querySelectorAll<HTMLElement>('.vis__frame').forEach((frame) => {
      const video = frame.querySelector('video');
      const toggle = frame.querySelector<HTMLButtonElement>('[data-vis-toggle]');
      if (!(video instanceof HTMLVideoElement) || !toggle) return;

      const label = toggle.querySelector('.vis__toggle-text');
      const calm = matchMedia('(prefers-reduced-motion: reduce)');

      const sync = () => {
        const playing = !video.paused;
        toggle.setAttribute('aria-pressed', String(playing));
        if (label) label.textContent = playing ? 'Pause' : 'Play';
      };

      toggle.addEventListener('click', () => {
        if (video.paused) video.play().catch(() => {});
        else video.pause();
        sync();
      });
      video.addEventListener('play', sync);
      video.addEventListener('pause', sync);

      if (calm.matches) return;

      let armed = false;
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              if (!armed) {
                armed = true;
                video.preload = 'auto';
                video.load();
              }
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          });
        },
        { threshold: 0.35 }
      );
      io.observe(frame);
    });
  };

  boot();
  document.addEventListener('astro:after-swap', boot);
</script>

<style>
  .vis {
    display: grid;
    gap: var(--s-5);
  }

  .vis__rail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--border-strong);
  }

  .vis__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
  }

  .vis__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
    animation: vis-pulse 2.4s ease-in-out infinite;
  }

  .vis__file {
    font-size: 0.7rem;
    color: var(--text-3);
  }

  .vis__frame {
    position: relative;
    margin: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-card);
    background: var(--deep);
    overflow: hidden;
  }

  .vis__video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .vis__toggle {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-1);
    background: color-mix(in srgb, var(--deep) 78%, transparent);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-pill);
    backdrop-filter: blur(6px);
    cursor: pointer;
    transition:
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .vis__toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .vis__icon {
    flex: none;
  }

  .vis__toggle[aria-pressed='false'] .vis__icon--pause,
  .vis__toggle[aria-pressed='true'] .vis__icon--play {
    display: none;
  }

  .vis__corner {
    position: absolute;
    width: 18px;
    height: 18px;
    pointer-events: none;
  }

  .vis__corner--tl {
    top: 10px;
    left: 10px;
    border-top: 1.5px solid var(--accent);
    border-left: 1.5px solid var(--accent);
  }

  .vis__corner--br {
    right: 10px;
    bottom: 10px;
    border-bottom: 1.5px solid var(--accent);
    border-right: 1.5px solid var(--accent);
  }

  .vis__body {
    display: grid;
    gap: var(--s-5);
  }

  .vis__copy h2 {
    max-width: 18ch;
  }

  .vis__copy p {
    margin-top: var(--s-4);
    max-width: 56ch;
    color: var(--text-2);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .vis__aside {
    font-size: 0.9375rem !important;
    color: var(--text-3) !important;
  }

  .vis__readout {
    margin: 0;
    padding: 0;
    align-self: start;
    border-top: 1px solid var(--border);
  }

  .vis__row {
    display: grid;
    gap: 0.125rem;
    padding: 0.6875rem 0;
    border-bottom: 1px solid var(--border);
  }

  .vis__row dd {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-1);
  }

  @media (min-width: 900px) {
    .vis__body {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: start;
    }

    .vis__row {
      grid-template-columns: 5rem minmax(0, 1fr);
      gap: var(--s-4);
      align-items: baseline;
    }
  }

  @keyframes vis-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vis__dot {
      animation: none;
    }
  }
</style>
