---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import AmbientField from '../components/AmbientField.astro';
import { site } from '../config/site';
import { Icon } from 'astro-icon/components';

const ledger = (await getCollection('blog'))
  .filter((p) => p.data.work && p.data.metric)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map((p) => ({ ...p, numeric: /(^|[\s·])[−-]?\d[\d,.]*\s*(%|k|M|\+|x)/i.test(p.data.metric ?? '') }));

const now = [
  {
    k: 'role',
    v: 'Machine Learning and Python Developer at Intalytic Group, since 2024',
  },
  {
    k: 'freelance',
    v: 'Open to project based work, scoped by deliverable rather than hours',
  },
  {
    k: 'in daily use',
    v: 'Python · FastAPI · LangGraph · OCR and vision extraction · Docker',
  },
];

const fits = [
  'Documents that arrive in nine different formats and still have to end up as records your software can read.',
  'Retrieval that has to answer from your own content and say nothing when the answer is not in there.',
  'Multi step jobs an agent should finish on its own, with a human check on the calls that carry risk.',
  'Problems where prompting a hosted model will not hold, and a model trained on your data will.',
];

const misfits = [
  'Frontend or design only builds. I will write the API your frontend calls, not the frontend.',
  'Research with no shipping target. I am not the person for a paper or a benchmark chase.',
  'A chatbot on the marketing site with nothing behind it. Without your data it is a toy.',
  'Anything where I cannot see the real files. Sample data hides every problem that matters.',
];

const shipped = [
  'Python',
  'FastAPI',
  'LangGraph',
  'OpenAI',
  'Anthropic',
  'OCR + vision extraction',
  'Scikit-learn',
  'XGBoost',
  'PostgreSQL',
  'MongoDB',
  'Docker',
  'AWS',
  'Fly.io',
  'Git',
];

const learning = ['PyTorch', 'TensorFlow', 'Keras', 'Advanced SQL tuning'];

const certifications = [
  {
    name: 'Machine Learning Specialization',
    issuer: 'DeepLearning.AI · Stanford',
    url: 'https://www.coursera.org/account/accomplishments/specialization/D7ZXNR9WHXFW',
  },
  {
    name: 'Retrieval Augmented Generation',
    issuer: 'Coursera',
    url: 'https://www.coursera.org/account/accomplishments/verify/D8FP5AIMY7NF',
  },
  {
    name: 'Azure AI Fundamentals',
    issuer: 'Microsoft Certified',
    url: 'https://learn.microsoft.com/en-us/users/alizain-7342/credentials/6b361a052f2f0d5d',
  },
  {
    name: 'Sequence Models',
    issuer: 'DeepLearning.AI',
    url: 'https://www.coursera.org/account/accomplishments/verify/ONLLHBF33K6T',
  },
];

const rail = [
  { k: 'Based', v: site.location },
  { k: 'Also known as', v: 'methezain' },
  { k: 'Hired as', v: 'AI Engineer · Python Developer · Machine Learning Engineer' },
  { k: 'Domains', v: 'Legal · Real estate · Finance · Payroll · eCommerce' },
  { k: 'Engagements', v: 'Freelance · Contract · Project based' },
];
---

<Layout
  title="About an AI Engineer and Python Developer"
  description="Ali Zain, known online as methezain, is an AI engineer and Python developer in Islamabad building document pipelines, RAG systems, and agent workflows."
>
  <section class="lead depth-top">
    <AmbientField class="lead__field" density={6800} />

    <div class="container-site lead__body">
      <div class="lead__meta">
        <span class="status-pill">
          <span class="status-pill__dot" aria-hidden="true"></span>
          Available for project work
        </span>
        <span class="mono-label lead__role">AI Engineer · Python Developer · {site.location}</span>
      </div>

      <div class="lead__grid">
        <div class="lead__copy">
          <Eyebrow>About</Eyebrow>
          <h1>Most of my work is reading the files nobody wants to read.</h1>
          <p class="lead__text">
            I am Ali Zain, an AI engineer and Python developer. On GitHub and most other places I
            am methezain. Since 2024 I have been at Intalytic Group building the pipelines that turn
            banking statements, property paperwork, and UK payroll files into structured records,
            and I take freelance projects alongside that.
          </p>
          <p class="lead__text">
            The work is less glamorous than the demos suggest. A scan is rotated, a table has no
            borders, a vendor changes their invoice layout in March. Getting that right is the job,
            and it is the part that decides whether anyone still uses the system in six months.
          </p>
          <div class="lead__actions">
            <Button href="/contact">Start a project</Button>
            <a href="/work" class="link-quiet">
              Read the case studies
              <Icon name="lucide:arrow-right" width={16} height={16} />
            </a>
          </div>
        </div>

        <figure class="portrait">
          <img
            src="/about/ali-zain.webp"
            alt="Ali Zain, also known as methezain, an AI engineer and Python developer"
            width="720"
            height="720"
            loading="eager"
            decoding="async"
          />
          <figcaption class="portrait__cap">
            <span class="mono">{site.name}</span>
            <span class="mono-label">@{site.alternateName}</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="strip" aria-labelledby="now-label">
    <div class="container-site">
      <h2 id="now-label" class="strip__label mono-label">Right now</h2>
      <dl class="nowlist">
        {
          now.map((n) => (
            <div class="nowlist__row">
              <dt class="mono-label">{n.k}</dt>
              <dd>{n.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Section id="fit" field={9000}>
    <div class="head-split">
      <div>
        <Eyebrow index="01">Fit</Eyebrow>
        <h2>Bring me the problems where the input is a mess.</h2>
      </div>
      <div class="head-split__aside">
        <a href="/services" class="link-quiet">
          What I build
          <Icon name="lucide:arrow-right" width={16} height={16} />
        </a>
      </div>
    </div>

    <div class="fitgrid">
      <div class="fitcol card" data-reveal>
        <p class="fitcol__head mono-label">
          <Icon class="fitcol__mark" name="lucide:check" width={14} height={14} />
          Worth an email
        </p>
        <ul class="fitlist">
          {fits.map((f) => <li>{f}</li>)}
        </ul>
      </div>

      <div class="fitcol card fitcol--out" data-reveal data-reveal-delay="80">
        <p class="fitcol__head mono-label">
          <Icon class="fitcol__mark" name="lucide:minus" width={14} height={14} />
          Not a fit
        </p>
        <ul class="fitlist">
          {misfits.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    </div>
  </Section>

  <Section id="ledger" tone="deep">
    <div class="head-bar">
      <div class="head-bar__rail">
        <Eyebrow index="02">Track record</Eyebrow>
        <a href="/work" class="link-quiet">
          All work
          <Icon name="lucide:arrow-right" width={16} height={16} />
        </a>
      </div>
      <h2>Shipped, with the figures attached.</h2>
      <p class="head-bar__lede">
        Every line below is a system somebody is using. The figures came off the running version, not
        off a validation split, and each one links to how it was built.
      </p>
    </div>

    <ol class="ledger">
      {
        ledger.map((p, i) => (
          <li class="ledger__row">
            <a class="ledger__link" href={`/blog/${p.slug}`}>
              <span class="index-marker ledger__i">{`//00${i + 1}`}</span>
              <span class="ledger__name">{p.data.cardTitle ?? p.data.title}</span>
              <span class="ledger__client mono-label">{p.data.client}</span>
              <span class:list={['ledger__figure', 'mono', { num: p.numeric }]}>{p.data.metric}</span>
              <span class="ledger__arrow" aria-hidden="true">
                <Icon name="lucide:arrow-up-right" width={15} height={15} />
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="background">
    <h2 class="head-statement">
      I learned this on files that were already broken, not on a dataset somebody had cleaned first.
    </h2>

    <div class="bg">
      <div class="bg__spine">
        <article class="post">
          <header class="post__head">
            <h3>Machine Learning and Python Developer</h3>
            <p class="post__meta mono-label">Intalytic Group Ltd · 2024 to now</p>
          </header>
          <ul class="post__list">
            <li>
              Build the document extraction and processing pipelines for banking, property, and UK
              payroll, pairing OCR with language and vision models so the format of the file stops
              mattering.
            </li>
            <li>
              Tune them on accuracy and on cost together. A pipeline nobody trusts is useless, and
              one nobody can afford to run at volume is the same thing.
            </li>
            <li>
              Own the API layer and ship to production with the DevOps team. Manual review on the
              banking intake dropped by 70 percent and processing time by 60 percent.
            </li>
          </ul>
        </article>

        <article class="post">
          <header class="post__head">
            <h3>BS, Information Technology</h3>
            <p class="post__meta mono-label">Quaid-i-Azam University · 2025</p>
          </header>
          <p class="post__text">
            Python, machine learning, and databases, plus the first time I had to hand something over
            and watch other people use it. The final year project was a case management system for a
            legal team that cut their case processing time, and it is
            <a href="/blog/legal-workflow-saas" class="link-inline">still written up here</a>.
          </p>
        </article>
      </div>

      <dl class="rail">
        {
          rail.map((r) => (
            <div class="rail__row">
              <dt class="mono-label">{r.k}</dt>
              <dd>{r.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <section class="strip strip--tall" aria-labelledby="toolkit-label">
    <div class="container-site">
      <h2 id="toolkit-label" class="strip__label strip__label--rule mono-label">Toolkit</h2>

      <div class="kit">
        <div class="kit__group">
          <p class="kit__label mono-label">Shipped to production</p>
          <ul class="kit__list">
            {shipped.map((t) => <li class="pill">{t}</li>)}
          </ul>
        </div>

        <div class="kit__group">
          <p class="kit__label mono-label">Used, not my depth</p>
          <ul class="kit__list">
            {learning.map((t) => <li class="pill">{t}</li>)}
          </ul>
          <p class="kit__note">
            Listed separately on purpose. If your problem lives here, you want somebody whose
            first list it is on.
          </p>
        </div>
      </div>

      <div class="certs">
        <p class="kit__label mono-label">Certifications</p>
        <ul class="certs__list">
          {
            certifications.map((c) => (
              <li class="certs__row">
                <a class="certs__link" href={c.url} target="_blank" rel="noopener noreferrer">
                  <span class="certs__name">{c.name}</span>
                  <span class="certs__issuer mono-label">{c.issuer}</span>
                  <span class="certs__verify mono-label">
                    Verify
                    <Icon name="lucide:arrow-up-right" width={12} height={12} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Section id="cta">
    <CtaBand
      title="Tell me what the files look like."
      lede="Send me the workflow, the ugly sample, and what it costs you in hours. I will tell you plainly whether this is worth automating and what it would take."
      note="Project based · I reply within a day"
    />
  </Section>
</Layout>

<style>
  .lead {
    position: relative;
    padding-top: clamp(1.75rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 4vw, 3.25rem);
    overflow: hidden;
  }

  .lead__field {
    -webkit-mask-image: radial-gradient(110% 90% at 78% 26%, #000 12%, transparent 70%);
    mask-image: radial-gradient(110% 90% at 78% 26%, #000 12%, transparent 70%);
  }

  .lead__body {
    position: relative;
    z-index: 1;
  }

  .lead__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-4);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--border);
  }

  .lead__role {
    color: var(--text-3);
  }

  .lead__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    margin-top: clamp(1.75rem, 3.4vw, 2.75rem);
  }

  .lead__copy h1 {
    margin-top: 0.875rem;
    max-width: 22ch;
  }

  .lead__text {
    margin-top: var(--s-5);
    max-width: 58ch;
    color: var(--text-2);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .lead__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-5);
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
  }

  .portrait {
    position: relative;
    margin: 0;
    max-width: 360px;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .portrait img {
    width: 100%;
    height: auto;
    filter: grayscale(0.14) contrast(1.03);
  }

  .portrait__cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    padding: 0.6875rem 0.875rem;
    border-top: 1px solid var(--border);
    background: var(--surface-2);
  }

  .portrait__cap .mono {
    font-size: 0.78rem;
    color: var(--text-1);
  }

  .portrait__cap .mono-label {
    color: var(--text-3);
  }

  .strip {
    padding-block: clamp(1.5rem, 2.4vw, 2.25rem);
    border-block: 1px solid var(--border);
  }

  .strip--tall {
    padding-block: clamp(2rem, 3.4vw, 3rem);
  }

  .strip__label {
    color: var(--text-3);
    font-size: 0.68rem;
  }

  .nowlist {
    margin: var(--s-4) 0 0;
    padding: 0;
  }

  .nowlist__row {
    display: grid;
    gap: 0.125rem;
    padding: 0.5625rem 0;
    border-top: 1px solid var(--border);
  }

  .nowlist__row dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-1);
  }

  .nowlist__row dt {
    color: var(--text-3);
  }

  .fitgrid {
    display: grid;
    gap: var(--s-4);
  }

  .fitcol {
    padding: clamp(1.375rem, 2.6vw, 1.875rem);
  }

  .fitcol--out {
    background: transparent;
    box-shadow: none;
  }

  .fitcol__head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 var(--s-4);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--border);
    color: var(--accent-hover);
  }

  .fitcol--out .fitcol__head {
    color: var(--text-3);
  }

  .fitcol__mark {
    flex: none;
  }

  .fitlist {
    display: grid;
    gap: var(--s-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fitlist li {
    max-width: 46ch;
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .fitcol--out .fitlist li {
    color: var(--text-3);
  }

  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .ledger__row {
    border-bottom: 1px solid var(--border);
  }

  .ledger__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: 'i name arrow' 'i figure arrow';
    align-items: center;
    column-gap: var(--s-4);
    row-gap: 0.25rem;
    padding: var(--s-4) 0;
    transition: background var(--dur-1) var(--ease-out);
  }

  .ledger__link:hover {
    background: var(--surface-1);
  }

  .ledger__link:active {
    background: var(--surface-2);
  }

  .ledger__i {
    grid-area: i;
  }

  .ledger__name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.012em;
  }

  .ledger__client {
    display: none;
    color: var(--text-3);
    text-align: left;
  }

  .ledger__figure {
    grid-area: figure;
    font-size: 0.78rem;
    color: var(--metric);
  }

  .ledger__arrow {
    grid-area: arrow;
    color: var(--text-3);
    transition:
      transform var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .ledger__link:hover .ledger__arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .bg {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    margin-top: clamp(1.75rem, 3.4vw, 2.5rem);
  }

  .bg__spine {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  .post {
    padding-top: var(--s-4);
    border-top: 1px solid var(--border-strong);
  }

  .post__head h3 {
    max-width: 42ch;
  }

  .post__meta {
    margin: 0.4375rem 0 0;
    color: var(--text-3);
  }

  .post__list {
    display: grid;
    gap: var(--s-4);
    margin: var(--s-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .post__list li {
    position: relative;
    max-width: 62ch;
    padding-left: var(--s-5);
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .post__list li::before {
    content: '';
    position: absolute;
    top: 0.6875rem;
    left: 0;
    width: 12px;
    height: 1px;
    background: var(--accent);
  }

  .post__text {
    margin: var(--s-5) 0 0;
    max-width: 62ch;
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .link-inline {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .link-inline:hover {
    color: var(--accent-hover);
  }

  .rail {
    margin: 0;
    padding: 0;
    align-self: start;
    border-top: 1px solid var(--border);
  }

  .rail__row {
    display: grid;
    gap: 0.125rem;
    padding: 0.6875rem 0;
    border-bottom: 1px solid var(--border);
  }

  .rail__row dt {
    color: var(--text-3);
  }

  .rail__row dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-1);
  }

  .strip__label--rule {
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--border-strong);
  }

  .kit {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(1.375rem, 2.4vw, 1.875rem);
  }

  .kit__label {
    margin: 0 0 var(--s-3);
    color: var(--text-3);
  }

  .kit__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .kit__note {
    margin: var(--s-4) 0 0;
    max-width: 40ch;
    color: var(--text-3);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .certs {
    margin-top: clamp(1.75rem, 3.4vw, 2.5rem);
  }

  .certs__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .certs__row {
    border-bottom: 1px solid var(--border);
  }

  .certs__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.25rem var(--s-4);
    padding: 0.75rem 0;
  }

  .certs__name {
    font-size: 0.9375rem;
    color: var(--text-1);
  }

  .certs__issuer {
    grid-column: 1;
    color: var(--text-3);
  }

  .certs__verify {
    grid-row: span 2;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--text-3);
    transition: color var(--dur-1) var(--ease-out);
  }

  .certs__link:hover .certs__verify {
    color: var(--accent);
  }

  .certs__link:active .certs__verify {
    color: var(--accent-hover);
  }

  @media (min-width: 640px) {
    .nowlist__row {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: var(--s-4);
      align-items: baseline;
    }

    .fitgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ledger__link {
      grid-template-columns: 3.25rem minmax(0, 1fr) minmax(0, 1.05fr) 1.25rem;
      grid-template-areas: 'i name figure arrow';
      column-gap: var(--s-4);
    }

    .ledger__figure {
      justify-self: end;
      text-align: right;
    }

    .rail__row {
      grid-template-columns: 6.5rem minmax(0, 1fr);
      gap: var(--s-4);
      align-items: baseline;
    }
  }

  @media (min-width: 900px) {
    .lead__grid {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
      align-items: end;
    }

    .portrait {
      width: 360px;
    }

    .nowlist {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 2.5rem);
    }

    .nowlist__row {
      grid-template-columns: 1fr;
      gap: 0.3125rem;
      align-items: start;
    }

    .ledger__link {
      grid-template-columns: 3.25rem minmax(0, 1fr) minmax(0, 0.82fr) minmax(0, 1.05fr) 1.25rem;
      grid-template-areas: 'i name client figure arrow';
      column-gap: var(--s-5);
      padding: var(--s-5) 0;
    }

    .ledger__client {
      display: block;
      grid-area: client;
    }

    .bg {
