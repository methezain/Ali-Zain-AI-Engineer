---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';

const principles = [
  {
    title: 'Requirement engineering',
    desc: 'Before any code, I get clear on the real problem, the constraints, and what a win looks like for you. That clarity keeps the build from drifting later.',
  },
  {
    title: 'Prototype and ship fast',
    desc: 'I reach a working prototype quickly, so you can try it instead of just reading about it. Real feedback beats months of planning.',
  },
  {
    title: 'Real systems, not notebooks',
    desc: 'A notebook or script is not a product. I design and deploy proper systems that hold up for real users and keep running after handoff.',
  },
];

const skills = [
  {
    group: 'AI / ML',
    items: [
      { name: 'Scikit-learn + XGBoost', level: 85 },
      { name: 'TensorFlow + PyTorch + Keras', level: 60 },
      { name: 'LLMs (OpenAI, Anthropic)', level: 95 },
      { name: 'API integration', level: 90 },
      { name: 'LangChain + LangGraph', level: 80 },
    ],
  },
  {
    group: 'Backend & System Design',
    items: [
      { name: 'Python + FastAPI + Flask', level: 90 },
      { name: 'AWS + Fly.io + Docker', level: 70 },
      { name: 'PostgreSQL + MongoDB', level: 75 },
      { name: 'SQL', level: 65 },
      { name: 'Git & GitHub', level: 80 },
    ],
  },
];

const certifications = [
  {
    name: 'Machine Learning Specialization',
    url: 'https://www.coursera.org/account/accomplishments/specialization/D7ZXNR9WHXFW',
  },
  {
    name: 'Retrieval Augmented Generation (RAG)',
    url: 'https://www.coursera.org/account/accomplishments/verify/D8FP5AIMY7NF?utm_source=link&utm_medium=certificate&utm_content=cert_image&utm_campaign=sharing_cta&utm_product=course',
  },
  {
    name: 'Microsoft Certified: Azure AI Fundamentals',
    url: 'https://learn.microsoft.com/en-us/users/alizain-7342/credentials/6b361a052f2f0d5d',
  },
  {
    name: 'Sequence Models',
    url: 'https://www.coursera.org/account/accomplishments/verify/ONLLHBF33K6T',
  },
];
---

<Layout
  title="About"
  description="Ali Zain is an AI engineer who builds LLM apps, retrieval systems, and automation that remove real work — shipped to production and measured, across finance, real estate, and legal."
>
  <!-- Intro -->
  <section class="intro">
    <div class="container-site intro__inner">
      <div class="intro__copy">
        <Eyebrow>About</Eyebrow>
        <h1 data-reveal>I build AI that <span class="mark">actually survives real users.</span></h1>
        <p class="intro__lead" data-reveal data-reveal-delay="80">
          I’m Ali Zain, an AI engineer who partners with fast-moving startups and
          businesses worldwide. I don’t build fragile wrappers or flashy demos
          that break under load. I build high-agency AI systems: retrieval
          pipelines, LLM agents, and automation engines designed to scale, cut
          costs, and actually work in production.
        </p>
        <p class="intro__lead" data-reveal data-reveal-delay="120">
          I care about shipping fast, keeping latency low, and building honest
          tech that solves real-world bottlenecks. If you need a developer who
          can own the AI stack and execute without hand-holding, let’s talk.
        </p>
        <div class="intro__actions" data-reveal data-reveal-delay="160">
          <Button href="/contact" magnetic>Work with me</Button>
          <a href="/work" class="link-accent intro__link" data-cursor="view">
            See my work <Icon name="lucide:arrow-right" width={16} height={16} />
          </a>
        </div>
      </div>

      <div class="portrait" data-reveal data-reveal-delay="140">
        <img
          src="/about/ali-zain.webp"
          alt="Ali Zain, AI engineer, smiling in front of a tree"
          width="720"
          height="720"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- Principles -->
  <Section id="principles" class="section-principles">
    <div class="section-head">
      <div>
        <Eyebrow>How I work</Eyebrow>
        <h2 data-reveal>From requirement to real users.</h2>
      </div>
    </div>
    <ol class="principles">
      {
        principles.map((p, i) => (
          <li class="principle" data-reveal data-reveal-delay={i * 60}>
            <span class="principle__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Experience & skills -->
  <Section id="background" class="section-background">
    <div class="background">
      <div class="background__col" data-reveal>
        <Eyebrow>Experience</Eyebrow>
        <div class="xp">
          <div class="xp__role">
            <h3>Machine Learning &amp; Python Developer</h3>
            <span class="xp__meta">Intalytic Group Ltd · 2024 – 2026</span>
          </div>
          <ul class="xp-list">
            <li>
              Built document extraction & processing pipelines for banking,
              real estate, and UK payroll, combining OCR, language
              models, and vision models to read files.
            </li>
            <li>
              Focused on reliability, accuracy and cost, making the pipelines accurate
              enough to trust and cheap enough to run at scale.
            </li>
            <li>
              Led API development and shipped to production with the DevOps team,
              cutting workloads by up to 70%, and created ease in overall workflows using technology. 
            </li>
          </ul>
        </div>
        <div class="xp">
          <div class="xp__role">
            <h3>BS, Information Technology</h3>
            <span class="xp__meta">Quaid-i-Azam University · 2025</span>
          </div>
          <p>
            This is where I built my foundation in Python, Machine Learning, and
            Databases, and where I first turned classroom theory into working
            software. It gave me the fundamentals I now use to design and ship
            real AI models and Agentic workflows.
          </p>
        </div>
      </div>

      <div class="background__col" data-reveal data-reveal-delay="100">
        <Eyebrow>Toolkit</Eyebrow>
        {
          skills.map((s) => (
            <div class="skills">
              <p class="skills__group">{s.group}</p>
              <ul class="skill-list">
                {s.items.map((it) => (
                  <li class="skill">
                    <span class="skill__name">{it.name}</span>
                    <span class="skill__bar">
                      <i style={`width:${it.level}%`} />
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="certs-block" data-reveal>
      <p class="certs-block__title">Certifications</p>
      <ul class="cert-list">
        {
          certifications.map((c) => (
            <li class="cert-item">
              <a
                class="cert-pill"
                href={c.url}
                target="_blank"
                rel="noopener noreferrer"
                data-cursor="view"
              >
                View<span class="cert-pill__word">&nbsp;certificate</span>
                <Icon name="lucide:arrow-up-right" width={13} height={13} />
              </a>
              <span class="cert-name">{c.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- Closing -->
  <Section id="closing" class="section-closing">
    <div class="closing">
      <div class="closing__copy" data-reveal>
        <Eyebrow>Available for work</Eyebrow>
        <h2>Let’s build something that lasts.</h2>
        <p>
          If you have a workflow that’s slow, manual, or hard to scale, I’d like
          to hear about it, and tell you honestly what AI can do for it.
        </p>
        <Button href="/contact" magnetic>Start a project</Button>
      </div>
    </div>
  </Section>
</Layout>

<style>
  .mark {
    color: var(--accent);
  }

  /* Intro */
  .intro {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }
  .intro__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }
  .intro h1 {
    margin-top: 0.75rem;
    max-width: 14ch;
  }
  .intro__lead {
    margin-top: 1.25rem;
    max-width: 52ch;
    color: var(--muted);
    font-size: 1.1rem;
  }
  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .intro__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 500;
  }

  /* Portrait — a single rounded photo */
  .portrait {
    width: 100%;
    max-width: 380px;
    margin-inline: auto;
  }
  .portrait img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 24px;
    border: 1px solid var(--border);
    box-shadow: 0 12px 32px rgba(57, 62, 65, 0.12);
  }

  /* Section heads */
  .section-head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .section-head h2 {
    margin-top: 0.5rem;
  }

  /* Principles */
  .principles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem 2rem;
  }
  .principle {
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
  }
  .principle__n {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--accent);
  }
  .principle h3 {
    font-size: 1.3rem;
    margin: 0.5rem 0;
  }
  .principle p {
    color: var(--muted);
    max-width: 46ch;
  }

  /* Experience & skills */
  .background {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
  }
  /* Columns size to their content; Toolkit pairs with Experience + Education,
     Certifications sits full width below. */
  .background {
    align-items: start;
  }
  .xp {
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
  }
  .background__col > .eyebrow + .xp {
    margin-top: 1.25rem;
  }
  .xp__role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .xp__role h3 {
    font-size: 1.15rem;
  }
  .xp__meta {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .xp p {
    color: var(--muted);
    max-width: 50ch;
  }
  .xp-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.7rem;
    max-width: 52ch;
  }
  .xp-list li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--muted);
  }
  .xp-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  /* Certifications */
  .certs-block {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .certs-block__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--ink);
    margin: 0 0 1.1rem;
  }
  .cert-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }
  .cert-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .cert-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex: none;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    padding: 0.3rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
    border-radius: 999px;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .cert-pill:hover {
    background: color-mix(in srgb, var(--accent) 10%, var(--surface));
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .cert-name {
    font-size: 0.95rem;
    color: var(--ink);
  }
  /* On small screens shorten the pill to just "View" so the name stays inline. */
  @media (max-width: 600px) {
    .cert-pill__word {
      display: none;
    }
  }

  .skills {
    margin-top: 1.25rem;
  }
  /* Extra breathing room between the two toolkit groups */
  .skills + .skills {
    margin-top: 3rem;
  }
  .skills__group {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    display: grid;
    gap: 0.85rem;
  }
  .skill {
    display: grid;
    gap: 0.4rem;
  }
  .skill__name {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
  }
  .skill__bar {
    height: 6px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 9%, var(--bg));
    overflow: hidden;
  }
  .skill__bar i {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--accent);
  }

  /* Closing */
  .closing {
    text-align: center;
  }
  .closing__copy {
    max-width: 48ch;
    margin-inline: auto;
  }
  .closing__copy h2 {
    margin: 0.5rem 0 1rem;
  }
  .closing__copy p {
    color: var(--muted);
    margin: 0 auto 1.75rem;
  }

  @media (min-width: 860px) {
    .intro__inner {
      grid-template-columns: 1.2fr 0.8fr;
    }
    .principles {
      grid-template-columns: repeat(3, 1fr);
    }
    .background {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
