---
import type { GetStaticPaths, Page } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import PostCard from '../../components/PostCard.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import Pagination from '../../components/Pagination.astro';
import { getSortedPosts, getCategories, PAGE_SIZE, FEATURED_COUNT, type Post } from '../../lib/blog';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getSortedPosts();
  const featured = posts.filter((p) => p.data.featured).slice(0, FEATURED_COUNT);
  const featuredSlugs = new Set(featured.map((p) => p.slug));
  // The main grid lists everything except the posts shown in the featured strip.
  const grid = posts.filter((p) => !featuredSlugs.has(p.slug));
  const categories = getCategories(posts);
  return paginate(grid, { pageSize: PAGE_SIZE, props: { featured, categories } });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
  featured: Post[];
  categories: { name: string; slug: string; count: number }[];
}
const { page, featured, categories } = Astro.props;
const isFirst = page.currentPage === 1;

const pageTitle = isFirst
  ? 'AI Engineering Blog'
  : `AI Engineering Blog, Page ${page.currentPage}`;
const description =
  'AI engineering case studies and technical notes by Ali Zain on LLM apps, RAG systems, document intelligence, and production ML delivery.';
---

<Layout title={pageTitle} description={description}>
  {page.url.prev && <link slot="head" rel="prev" href={page.url.prev} />}
  {page.url.next && <link slot="head" rel="next" href={page.url.next} />}

  <!-- Hero -->
  <section class="blog-hero">
    <div class="container-site">
      <Eyebrow>Blog</Eyebrow>
      <h1 data-reveal>Notes from the build.</h1>
      <p class="blog-hero__lede" data-reveal data-reveal-delay="80">
        Case studies from real projects and short technical notes on how I
        approach LLM apps, retrieval, document intelligence, and shipping AI to
        production.
      </p>
    </div>
  </section>

  <Section id="posts" class="section-posts">
    <CategoryFilter categories={categories} active={null} />

    {
      isFirst && featured.length > 0 && (
        <div class="featured">
          <div class="featured__header">
            <p class="featured__label">Featured</p>
            <div class="featured__arrows">
              <button class="feat-arrow feat-arrow--prev" id="featPrev" aria-label="Previous featured post">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <button class="feat-arrow feat-arrow--next" id="featNext" aria-label="Next featured post">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            </div>
          </div>
          <div class="feat-slider-wrap">
            <div class="feat-track" id="featTrack">
              {/* Real slides + clones at end for seamless forward infinite loop */}
              {[...featured, ...featured].map((entry, i) => (
                <div class="feat-slide" data-index={i}>
                  <PostCard entry={entry} />
                </div>
              ))}
            </div>
          </div>
          {/* Dots – one per real card */}
          <div class="feat-dots" id="featDots" aria-hidden="true">
            {featured.map((_, i) => (
              <button class={`feat-dot${i === 0 ? ' is-active' : ''}`} data-dot={i} aria-label={`Go to slide ${i + 1}`}></button>
            ))}
          </div>
        </div>
      )
    }

    <div class="posts-section">
      <div class="posts-section__divider"></div>
      <p class="posts-section__label">All Posts</p>
      <div class="grid-posts">
        {page.data.map((entry) => <PostCard entry={entry} />)}
      </div>
    </div>

    <Pagination currentPage={page.currentPage} lastPage={page.lastPage} base="/blog" />
  </Section>
</Layout>

<style>

  .blog-hero {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: clamp(0.5rem, 2vw, 1.5rem);
  }
  .blog-hero h1 {
    margin-top: 0.75rem;
    max-width: 16ch;
  }
  .blog-hero__lede {
    margin-top: 1.5rem;
    max-width: 58ch;
    color: var(--text-2);
    font-size: 1.15rem;
  }

  /* ── Featured Slider ─────────────────────────────────── */
  .featured {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .featured__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }
  .featured__label {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-2);
    margin: 0;
  }
  .featured__arrows {
    display: flex;
    gap: 0.5rem;
  }
  .feat-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface-1);
    color: var(--text-1);
    cursor: pointer;
    transition: background 0.18s, border-color 0.18s, color 0.18s;
  }
  .feat-arrow:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  /* The outer div clips overflow while the inner wrapper extends past the container
     so side cards can peek in from both edges. */
  .feat-slider-wrap {
    overflow: hidden;
    width: 100%;
    padding: 0.25rem 0; /* vertical room for card shadows */
  }
  .feat-track {
    display: flex;
    gap: 1.25rem;
    will-change: transform;
  }
  .feat-slide {
    /* Mobile: 1 card */
    flex: 0 0 100%;
    min-width: 0;
  }

  @media (min-width: 640px) {
    /* Tablet: 2 cards */
    .feat-slide {
      flex: 0 0 calc(50% - 0.625rem);
    }
  }
  @media (min-width: 960px) {
    /* Desktop: 3 complete cards */
    .feat-slide {
      flex: 0 0 calc(33.333% - 0.834rem);
    }
  }

  /* Dots */
  .feat-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .feat-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: none;
    background: var(--border);
    cursor: pointer;
    padding: 0;
    transition: background 0.25s, transform 0.25s;
  }
  .feat-dot.is-active {
    background: var(--accent);
    transform: scale(1.35);
  }

  /* ── Posts Section ──────────────────────────────────── */
  .posts-section {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .posts-section__divider {
    height: 1px;
    background: var(--border);
    margin-bottom: 2rem;
  }
  .posts-section__label {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-2);
    margin: 0 0 1.25rem;
  }
  .grid-posts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 720px) {
    .grid-posts { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .grid-posts { grid-template-columns: repeat(3, 1fr); }
  }
</style>

<script>
  (function () {
    const track   = document.getElementById('featTrack')  as HTMLElement | null;
    const prevBtn = document.getElementById('featPrev')   as HTMLButtonElement | null;
    const nextBtn = document.getElementById('featNext')   as HTMLButtonElement | null;
    const dotsEl  = document.getElementById('featDots')   as HTMLElement | null;
    if (!track || !prevBtn || !nextBtn) return;

    const allSlides = Array.from(track.querySelectorAll<HTMLElement>('.feat-slide'));
    if (!allSlides.length) return;

    // Half are real slides, half are clones appended for seamless forward roll
    const realCount = allSlides.length / 2;
    let physIdx = 0;   // physical index into allSlides (0 … realCount*2-1)
    let busy    = false; // block overlapping transitions
    let timer: ReturnType<typeof setInterval> | null = null;

    // ── Dots ───────────────────────────────────────────────
    const dots = dotsEl
      ? Array.from(dotsEl.querySelectorAll<HTMLElement>('.feat-dot'))
      : [];

    function updateDots() {
      // logical index wraps: clone zone maps back to same dot as real zone
      const logIdx = physIdx % realCount;
      dots.forEach((d, i) => d.classList.toggle('is-active', i === logIdx));
    }

    // ── Low-level position setter ──────────────────────────────
    function setPos(idx: number, animated: boolean) {
      // Raw offsetLeft – no maxOffset clamp so clone positions are reachable
      const offset = allSlides[idx].offsetLeft;
      track!.style.transition = animated
        ? 'transform 0.45s cubic-bezier(0.4, 0, 0.2, 1)'
        : 'none';
      track!.style.transform = `translateX(-${offset}px)`;
    }

    // ── Navigation ────────────────────────────────────────────
    function next() {
      if (busy) return;
      const nextPhys = physIdx + 1;

      // Safety: if somehow past all clones, reset silently
      if (nextPhys >= realCount * 2) {
        physIdx = 0; setPos(0, false); updateDots(); return;
      }

      busy = true;
      physIdx = nextPhys;
      setPos(nextPhys, true);
      updateDots();

      track!.addEventListener('transitionend', () => {
        if (nextPhys >= realCount) {
          // In clone zone — snap silently to equivalent real slide (same visual)
          const resetTo = nextPhys - realCount;
          physIdx = resetTo;
          setPos(resetTo, false);
        }
        busy = false;
      }, { once: true });
    }

    function prev() {
      if (busy) return;
      if (physIdx <= 0) {
        // No clone before index 0 — snap directly to last real slide
        physIdx = realCount - 1;
        setPos(physIdx, false);
        updateDots();
        return;
      }
      busy = true;
      physIdx -= 1;
      setPos(physIdx, true);
      updateDots();
      track!.addEventListener('transitionend', () => { busy = false; }, { once: true });
    }

    function goTo(logicalIdx: number) {
      if (busy) return;
      physIdx = Math.max(0, Math.min(logicalIdx, realCount - 1));
      setPos(physIdx, true);
      updateDots();
    }

    // ── Auto-play ─────────────────────────────────────────────
    function startAuto() {
      if (timer) clearInterval(timer);
      // Auto-play skips if busy so it never queues up
      timer = setInterval(() => { if (!busy) next(); }, 3000);
    }
    function stopAuto() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    // ── Events ─────────────────────────────────────────────
    nextBtn.addEventListener('click', () => { next(); stopAuto(); startAuto(); });
    prevBtn.addEventListener('click', () => { prev(); stopAuto(); startAuto(); });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { goTo(i); stopAuto(); startAuto(); });
    });

    track.addEventListener('mouseenter', stopAuto);
    track.addEventListener('mouseleave', startAuto);

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => setPos(physIdx, false), 120);
    });

    requestAnimationFrame(() => {
      setPos(0, false);
      startAuto();
    });
  })();
</script>

