---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import LiveBadge from '../../components/LiveBadge.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../../config/site';
import { getSortedPosts, categorySlug, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((entry, i) => ({
    params: { slug: entry.slug },
    // `next` = the following (older) post, for end-of-article navigation.
    props: { entry, next: posts[i + 1] ?? null },
  }));
}

interface Props {
  entry: Post;
  next: Post | null;
}
const { entry, next } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();

const dateLabel = data.pubDate.toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const backHref = data.work ? '/work' : '/blog';
const backLabel = data.work ? 'Back to AI case studies' : 'Back to AI engineering blog';
const evidenceContext = data.client ?? `${data.category} article`;

const liveCitations = [
  ...(data.liveUrl ? [{ label: 'Live project', url: data.liveUrl }] : []),
  ...((data.liveLinks ?? []).map((item) => ({ label: item.label, url: item.url }))),
];
const citationEntries = [...data.citations, ...liveCitations];
const citationMap = new Map<string, string>();
for (const citation of citationEntries) {
  if (!citationMap.has(citation.url)) {
    citationMap.set(citation.url, citation.label);
  }
}
const citations = [...citationMap.entries()].map(([url, label]) => ({ url, label }));

// Structured data — absolute URLs required, so resolve against the site origin.
const origin = Astro.site ?? site.url;
const canonicalUrl = new URL(Astro.url.pathname, origin).href;
const imageUrl = new URL(data.image, origin).href;
const author = {
  '@type': 'Person',
  name: site.name,
  url: site.url,
  sameAs: [site.social.github, site.social.linkedin],
};
const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  image: [imageUrl],
  datePublished: data.pubDate.toISOString(),
  dateModified: data.pubDate.toISOString(),
  author,
  publisher: author,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  url: canonicalUrl,
  articleSection: data.category,
  ...(data.tags.length ? { keywords: data.tags.join(', ') } : {}),
  ...(citations.length ? { citation: citations.map((citation) => citation.url) } : {}),
  inLanguage: 'en',
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', origin).href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', origin).href },
    {
      '@type': 'ListItem',
      position: 3,
      name: data.category,
      item: new URL(`/blog/category/${categorySlug(data.category)}`, origin).href,
    },
    { '@type': 'ListItem', position: 4, name: data.title, item: canonicalUrl },
  ],
};
---

<Layout title={data.cardTitle ?? data.title} description={data.description} image={data.image} type="article">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>

  <article class="post">
    <div class="container-site">
      <a href={backHref} class="post__back link-accent">
        <Icon name="lucide:arrow-left" width={16} height={16} />
        {backLabel}
      </a>

      <div class="post__head">
        <h1 data-reveal>{data.title}</h1>
        <p class="post__standfirst" data-reveal data-reveal-delay="60">
          {data.description}
        </p>
      </div>

      <div class="post__cover">
        <img
          src={data.image}
          alt={data.imageAlt}
          width="1200"
          height="800"
          loading="eager"
          decoding="async"
        />
      </div>



      <section class="post__evidence" aria-label="Post details">
        <!-- Top row: Category · Date · Client -->
        <dl class="post__evidence-grid">
          <div>
            <dt>Category</dt>
            <dd class="post__evidence-cat">{data.category}</dd>
          </div>
          <div>
            <dt>Published</dt>
            <dd>{dateLabel}</dd>
          </div>
          {data.client && (
            <div>
              <dt>Client</dt>
              <dd>{evidenceContext}</dd>
            </div>
          )}
        </dl>

        <!-- Bottom row: Tags + Visit buttons (only if either exists) -->
        {(data.tags.length > 0 || data.liveUrl || (data.liveLinks && data.liveLinks.length > 0)) && (
          <div class="post__evidence-foot">
            {data.tags.length > 0 && (
              <ul class="post__evidence-tags" aria-label="Tags">
                {data.tags.map((t) => <li>{t}</li>)}
              </ul>
            )}
            {(data.liveUrl || (data.liveLinks && data.liveLinks.length > 0)) && (
              <div class="post__evidence-live-actions">
                {data.liveUrl && !data.liveLinks?.length && (
                  <a
                    href={data.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="post__visit-btn"
                  >
                    <Icon name="lucide:external-link" width={14} height={14} aria-hidden="true" />
                    Visit project
                  </a>
                )}
                {data.liveLinks && data.liveLinks.length > 0 && data.liveLinks.map((l) => (
                  <a
                    href={l.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="post__visit-btn"
                  >
                    <Icon name="lucide:external-link" width={14} height={14} aria-hidden="true" />
                    {l.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        )}
      </section>

      <div class="post__body prose">
        <Content />
      </div>

      <div class="post__foot">
        {
          next ? (
            <a href={`/blog/${next.slug}`} class="post__next">
              <span class="post__next-label">
                Next article <Icon name="lucide:arrow-right" width={15} height={15} />
              </span>
              <span class="post__next-title">{next.data.title}</span>
            </a>
          ) : (
            <a href={backHref} class="link-accent post__foot-link">
              {backLabel} <Icon name="lucide:arrow-right" width={16} height={16} />
            </a>
          )
        }
      </div>
    </div>

    <!-- CTA -->
    <div class="post-cta">
      <div class="container-site">
        <CtaBand
          title="Building something similar?"
          lede="If you have a workflow that's slow, manual, or hard to scale, I can tell you what AI can realistically do about it."
        />
      </div>
    </div>
  </article>
</Layout>

<style>
  .post {
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }
  .post__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 500;
    font-size: 0.9rem;
  }

  .post__head {
    max-width: 55rem;
    margin: clamp(1.5rem, 4vw, 2.5rem) auto 0;
    text-align: center;
  }
  .post__head h1 {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.15;
  }
  .post__standfirst {
    margin-top: 1.25rem;
    font-size: 1.2rem;
    color: var(--text-2);
  }

  .post__cover {
    max-width: 55rem;
    margin: clamp(2rem, 5vw, 3.5rem) auto 0;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border);
    aspect-ratio: 16 / 9;
  }
  .post__cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Post details box */
  .post__evidence {
    max-width: 55rem;
    margin: clamp(2rem, 4vw, 3rem) auto 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface-1);
    box-shadow: var(--shadow-card);
  }

  /* Top row — Category · Published · Client */
  .post__evidence-grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 1.5rem;
  }
  .post__evidence-grid dt {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-3);
    margin-bottom: 0.25rem;
  }
  .post__evidence-grid dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.975rem;
    color: var(--text-1);
    line-height: 1.3;
  }
  .post__evidence-cat {
    color: var(--accent);
  }

  /* Bottom row — Tags + Visit buttons */
  .post__evidence-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .post__evidence-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post__evidence-tags li {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-2);
    background: var(--surface-2);
  }
  .post__evidence-live-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .post__visit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-bg);
    border: 1px solid transparent;
    border-radius: var(--r-control, 8px);
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      transform 0.1s var(--spring-ui, ease);
  }
  .post__visit-btn:hover {
    background: color-mix(in srgb, var(--accent-bg) 70%, var(--surface-2));
    border-color: var(--border-strong);
  }
  .post__visit-btn:active {
    transform: scale(0.97);
  }
  @media (min-width: 640px) {
    .post__evidence-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem 2rem;
    }
  }

  /* Prose body */
  .post__body {
    max-width: 55rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
  }
  .prose :global(h2) {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    margin: 2.25rem 0 0.75rem;
  }
  .prose :global(h3) {
    font-size: 1.25rem;
    margin: 1.75rem 0 0.5rem;
  }
  .prose :global(p) {
    margin: 0 0 1.15rem;
    line-height: 1.75;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.15rem;
    padding-left: 1.25rem;
  }
  .prose :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose :global(strong) {
    font-weight: 600;
    color: var(--text-1);
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--accent);
    color: var(--text-2);
    font-style: italic;
  }
  .prose :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
    background: color-mix(in srgb, var(--text-1) 6%, var(--bg));
    padding: 0.15em 0.4em;
    border-radius: 6px;
  }

  .post__foot {
    max-width: 55rem;
    margin: clamp(2rem, 4vw, 3rem) auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
  }
  .post__foot-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 500;
  }
  .post__next {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    text-align: right;
    max-width: 60%;
  }
  .post__next-label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .post__next-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--text-1);
    transition: color 0.15s ease;
  }
  .post__next:hover .post__next-title {
    color: var(--accent);
  }


  /* CTA */
  .post-cta {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
</style>
