---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../config/site';

const telHref = `tel:${site.phone.replace(/[^+\d]/g, '')}`;

const contactMethods = [
  {
    icon: 'lucide:mail',
    label: 'Email',
    value: site.email,
    href: `mailto:${site.email}`,
    copyable: true,
    id: 'copy-email',
  },
  {
    icon: 'lucide:phone',
    label: 'Phone',
    value: site.phone,
    href: telHref,
    copyable: false,
  },
];

const socialLinks = [
  { label: 'GitHub', href: site.social.github, icon: 'lucide:github' },
  { label: 'LinkedIn', href: site.social.linkedin, icon: 'lucide:linkedin' },
  { label: 'Instagram', href: site.social.instagram, icon: 'lucide:instagram' },
];
---

<Layout
  title="Contact an AI Engineer"
  description="Contact Ali Zain (methezain), an AI engineer and Python developer, about LLM apps, RAG systems, document pipelines, and automation for manual workflows."
>
  <section class="contact">
    <div class="container-site">

      <!-- Page header -->
      <header class="contact__header" data-reveal>
        <Eyebrow>Get in touch</Eyebrow>
        <h1>Let's build something.</h1>
        <p class="contact__lede">
          Tell me what's slow, manual, or hard to scale. I read every message
          and usually reply within a day.
        </p>
      </header>

      <!-- Two-column grid -->
      <div class="contact__grid">

        <!-- LEFT: Form -->
        <div class="contact__form-wrap" data-reveal data-reveal-delay="40">
          <form id="contact-form" class="cform" novalidate>

            <!-- Name + Email row -->
            <div class="cform__row">
              <div class="cfield">
                <label class="cfield__label" for="name">Full name</label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  placeholder="John Doe"
                  required
                />
                <p class="cfield__error" data-error-for="name" aria-live="polite"></p>
              </div>

              <div class="cfield">
                <label class="cfield__label" for="email">Email</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  inputmode="email"
                  autocomplete="email"
                  placeholder="your@email.com"
                  required
                />
                <p class="cfield__error" data-error-for="email" aria-live="polite"></p>
              </div>
            </div>

            <div class="cfield">
              <label class="cfield__label" for="subject">What's this about?</label>
              <input
                id="subject"
                name="subject"
                type="text"
                placeholder="LLM app, RAG system, automation..."
              />
            </div>

            <div class="cfield">
              <label class="cfield__label" for="message">Message</label>
              <textarea
                id="message"
                name="message"
                rows="6"
                placeholder="Describe what's slow, repetitive, or hard to scale in your workflow..."
                required
              ></textarea>
              <p class="cfield__error" data-error-for="message" aria-live="polite"></p>
            </div>

            <!-- Honeypot -->
            <div class="hp" aria-hidden="true">
              <label>Company<input name="company" tabindex="-1" autocomplete="off" /></label>
            </div>

            <div class="cform__footer">
              <button type="submit" class="btn btn-primary cform__submit" id="submit-btn">
                <Icon name="lucide:send" width={16} height={16} />
                Send message
              </button>
              <p class="cform__note">
                <Icon name="lucide:shield-check" width={13} height={13} />
                No newsletters, no spam.
              </p>
            </div>

          </form>
        </div>

        <!-- RIGHT: Direct contact panel -->
        <aside class="direct" data-reveal data-reveal-delay="120">

          {site.available && (
            <div class="direct__status">
              <span class="status-dot" aria-hidden="true"></span>
              <span>Available for new projects</span>
            </div>
          )}

          <div class="direct__methods">
            {contactMethods.map((m) => (
              <div class="dmethod">
                <div class="dmethod__icon-wrap" aria-hidden="true">
                  <Icon name={m.icon} width={16} height={16} />
                </div>
                <div class="dmethod__body">
                  <span class="dmethod__label">{m.label}</span>
                  <div class="dmethod__row">
                    <a href={m.href} class="dmethod__value">{m.value}</a>
                    {m.copyable && (
                      <button
                        type="button"
                        class="copy-btn"
                        id={m.id}
                        data-copy={m.value}
                        aria-label={`Copy ${m.label.toLowerCase()} address`}
                      >
                        <Icon name="lucide:copy" width={13} height={13} />
                      </button>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>

          <hr class="direct__divider" />

          <div class="direct__socials">
            <span class="direct__section-label">Find me elsewhere</span>
            <div class="direct__social-list">
              {socialLinks.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="social-link"
                  aria-label={s.label}
                >
                  <Icon name={s.icon} width={16} height={16} />
                  <span>{s.label}</span>
                </a>
              ))}
            </div>
          </div>

          <hr class="direct__divider" />

          <div class="direct__promise">
            <Icon name="lucide:clock" width={15} height={15} class="direct__promise-icon" />
            <p>I typically reply within <strong>24 hours</strong> on business days. If your need is urgent, mention it in the subject.</p>
          </div>

        </aside>
      </div>
    </div>
  </section>

  <!-- Toast -->
  <div id="toast" class="toast" role="status" aria-live="polite" hidden>
    <span class="toast__icon"><Icon name="lucide:check" width={18} height={18} /></span>
    <span id="toast-msg"></span>
  </div>
</Layout>

<style>
  /* Section */
  .contact {
    padding-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: clamp(4rem, 9vw, 8rem);
  }

  /* Header */
  .contact__header {
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
    max-width: 680px;
  }
  .contact__header h1 {
    margin-top: 0.6rem;
    margin-bottom: 0;
    font-size: clamp(2rem, 4.5vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .contact__lede {
    margin-top: 1rem;
    max-width: 56ch;
    color: var(--text-2);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  /* Grid */
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }

  /* Form card */
  .contact__form-wrap {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    box-shadow: var(--shadow-card);
  }

  /* Form layout */
  .cform {
    display: grid;
    gap: 1.25rem;
  }
  .cform__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  /* Fields */
  .cfield {
    display: grid;
    gap: 0.4rem;
  }
  .cfield__label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--text-1);
  }
  .cfield input,
  .cfield textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text-1);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.7rem 0.875rem;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  .cfield input::placeholder,
  .cfield textarea::placeholder {
    color: var(--text-3);
  }
  .cfield textarea {
    resize: vertical;
    min-height: 9rem;
    line-height: 1.6;
  }
  .cfield input:focus-visible,
  .cfield textarea:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent);
  }
  .cfield input[aria-invalid='true'],
  .cfield textarea[aria-invalid='true'] {
    border-color: var(--danger);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--danger) 14%, transparent);
  }
  .cfield__error {
    font-size: 0.78rem;
    color: var(--danger);
    min-height: 1rem;
  }
  .cfield__error:empty {
    display: none;
  }

  /* Honeypot */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Form footer */
  .cform__footer {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }
  .cform__submit {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.4rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .cform__submit[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .cform__note {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: var(--text-3);
  }
  .cform__note svg {
    color: var(--accent);
    flex-shrink: 0;
  }

  /* Direct contact aside */
  .direct {
    display: grid;
    gap: 1.5rem;
    align-content: start;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: clamp(1.5rem, 3.5vw, 2rem);
    box-shadow: var(--shadow-card);
  }

  /* Status badge */
  .direct__status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-bg);
    border-radius: 999px;
    padding: 0.35rem 0.9rem 0.35rem 0.65rem;
    width: fit-content;
    letter-spacing: 0.01em;
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.55; transform: scale(0.85); }
  }

  /* Method rows */
  .direct__methods {
    display: grid;
    gap: 1rem;
  }
  .dmethod {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }
  .dmethod__icon-wrap {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--accent);
    margin-top: 2px;
  }
  .dmethod__body {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }
  .dmethod__label {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-3);
  }
  .dmethod__row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .dmethod__value {
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--text-1);
    text-decoration: none;
    transition: color 0.15s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dmethod__value:hover {
    color: var(--accent);
  }

  /* Copy button */
  .copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: transparent;
    color: var(--text-3);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .copy-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-bg);
  }
  .copy-btn:active {
    transform: scale(0.93);
  }

  /* Divider */
  .direct__divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 0;
  }

  /* Socials */
  .direct__socials {
    display: grid;
    gap: 0.75rem;
  }
  .direct__section-label {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-3);
  }
  .direct__social-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-2);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.4rem 0.75rem;
    text-decoration: none;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease,
      transform 0.15s ease;
  }
  .social-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-bg);
    transform: translateY(-2px);
  }
  .social-link:active {
    transform: translateY(0) scale(0.97);
  }

  /* Response promise */
  .direct__promise {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.85rem 1rem;
    background: var(--accent-bg);
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
  }
  .direct__promise-icon {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .direct__promise p {
    font-size: 0.83rem;
    color: var(--text-2);
    line-height: 1.55;
    margin: 0;
  }
  .direct__promise strong {
    color: var(--text-1);
    font-weight: 600;
  }

  /* Toast */
  .toast {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    transform: translate(-50%, 1.5rem);
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    max-width: calc(100vw - 2rem);
    padding: 0.85rem 1.15rem;
    background: var(--text-1);
    color: var(--bg);
    border-radius: var(--r-control);
    box-shadow: var(--shadow-lift);
    font-size: 0.9rem;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .toast.is-error {
    background: var(--danger);
    color: #fff;
  }
  .toast__icon {
    display: inline-flex;
    color: var(--accent);
    background: var(--bg);
    border-radius: 50%;
    padding: 2px;
  }
  .toast.is-error .toast__icon {
    color: #fff;
    background: transparent;
    padding: 0;
  }

  /* Responsive */
  @media (min-width: 600px) {
    .cform__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 860px) {
    .contact__grid {
      grid-template-columns: 1.45fr 1fr;
      gap: 2rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .status-dot { animation: none; }
    .social-link:hover { transform: none; }
  }
</style>

<script>
  // Stricter email validation — rejects missing TLD, consecutive dots, spaces
  function validateEmail(email: string): boolean {
    return /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$/.test(email)
      && !/\.{2,}/.test(email)          // no consecutive dots
      && email.length <= 254;           // RFC 5321 length limit
  }

  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const toast    = document.getElementById('toast');
    const toastMsg = document.getElementById('toast-msg');
    const submit   = document.getElementById('submit-btn') as HTMLButtonElement | null;
    let toastTimer: number | undefined;

    const showToast = (msg: string, isError = false) => {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = msg;
      toast.classList.toggle('is-error', isError);
      toast.hidden = false;
      void toast.offsetWidth;
      toast.classList.add('is-visible');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toast.classList.remove('is-visible');
        window.setTimeout(() => (toast.hidden = true), 300);
      }, 5000);
    };

    const setError = (name: string, msg: string) => {
      const field = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      const input = form.querySelector<HTMLElement>(`[name="${name}"]`);
      if (field) field.textContent = msg;
      if (input) input.setAttribute('aria-invalid', msg ? 'true' : 'false');
    };

    const validate = (data: Record<string, string>) => {
      let firstInvalid: string | null = null;
      const fail = (n: string, m: string) => {
        setError(n, m);
        if (!firstInvalid) firstInvalid = n;
      };
      setError('name', '');
      setError('email', '');
      setError('message', '');
      if (!data.name.trim())    fail('name',    'Please enter your name.');
      if (!data.email.trim())   fail('email',   'Please enter your email.');
      else if (!validateEmail(data.email)) fail('email', 'Please enter a valid email address.');
      if (!data.message.trim()) fail('message', 'Please add a short message.');
      return firstInvalid;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd   = new FormData(form);
      const data = {
        name:    String(fd.get('name')    ?? ''),
        email:   String(fd.get('email')   ?? ''),
        subject: String(fd.get('subject') ?? ''),
        message: String(fd.get('message') ?? ''),
        company: String(fd.get('company') ?? ''),
      };

      const firstInvalid = validate(data);
      if (firstInvalid) {
        form.querySelector<HTMLElement>(`[name="${firstInvalid}"]`)?.focus();
        return;
      }

      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending\u2026';
      }

      try {
        const endpoints = [
          'https://alizain-contact-api.methealizain.workers.dev/api/contact',
          '/api/contact',
          '/api/contact.php',
        ];
        let sent = false;

        for (const endpoint of endpoints) {
          try {
            const res  = await fetch(endpoint, {
              method:  'POST',
              headers: { 'Content-Type': 'application/json' },
              body:    JSON.stringify(data),
            });
            const json = await res.json().catch(() => null);
            if (res.ok && json && json.ok) {
              sent = true;
              break;
            }
          } catch { /* try next */ }
        }

        if (sent) {
          form.reset();
          showToast('Thanks \u2014 I\u2019ll get back to you soon.');
        } else {
          throw new Error('send failed');
        }
      } catch {
        showToast('Couldn\u2019t send just now \u2014 please email methealizain@gmail.com.', true);
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg> Send message';
        }
      }
    });

    const copyBtn = document.getElementById('copy-email');
    copyBtn?.addEventListener('click', async () => {
      const value = copyBtn.getAttribute('data-copy') ?? '';
      try {
        await navigator.clipboard.writeText(value);
        showToast('Email copied to clipboard.');
      } catch {
        showToast('Couldn\u2019t copy \u2014 please copy it manually.', true);
      }
    });
  }

  document.addEventListener('astro:page-load', initContactForm);
</script>
