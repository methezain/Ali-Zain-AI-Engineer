---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../config/site';

const telHref = `tel:${site.phone.replace(/[^+\d]/g, '')}`;
---

<Layout
  title="Contact an AI Engineer"
  description="Contact Ali Zain (methezain), an AI engineer and Python developer, about LLM apps, RAG systems, document pipelines, and automation for manual workflows."
>
  <section class="contact">
    <div class="container-site">
      <div class="contact__head">
        <Eyebrow>Contact</Eyebrow>
        <h1 data-reveal>Let’s build something.</h1>
        <p class="contact__lede" data-reveal data-reveal-delay="80">
          Tell me what’s slow, manual, or hard to scale in your business. I read
          every message and usually reply within a day.
        </p>
      </div>

      <div class="contact__grid">
        <!-- Form -->
        <form id="contact-form" class="form" novalidate data-reveal>
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
            <p class="field__error" data-error-for="name" aria-live="polite"></p>
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" inputmode="email" autocomplete="email" required />
            <p class="field__error" data-error-for="email" aria-live="polite"></p>
          </div>

          <div class="field field--message">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="6" required></textarea>
            <p class="field__error" data-error-for="message" aria-live="polite"></p>
          </div>

          <!-- Honeypot: hidden from humans, catches bots -->
          <div class="hp" aria-hidden="true">
            <label>Company<input name="company" tabindex="-1" autocomplete="off" /></label>
          </div>

          <button type="submit" class="btn btn-primary form__submit">
            Send message
          </button>
          <p class="form__note">I’ll never share your details. No newsletters, no spam.</p>
        </form>

        <!-- Direct methods -->
        <aside class="direct" data-reveal data-reveal-delay="100">
          <div class="direct__block">
            <span class="direct__label">Email</span>
            <div class="direct__row">
              <a href={`mailto:${site.email}`} class="direct__value">{site.email}</a>
              <button type="button" class="copy" id="copy-email" data-copy={site.email} aria-label="Copy email address">
                <Icon name="lucide:copy" width={16} height={16} />
              </button>
            </div>
          </div>

          <div class="direct__block">
            <span class="direct__label">Phone</span>
            <a href={telHref} class="direct__value">{site.phone}</a>
          </div>

          <div class="direct__block">
            <span class="direct__label">Elsewhere</span>
            <div class="direct__socials">
              <a href={site.social.github} target="_blank" rel="noopener" class="direct__value">GitHub</a>
              <a href={site.social.linkedin} target="_blank" rel="noopener" class="direct__value">LinkedIn</a>
            </div>
          </div>

          {
            site.available && (
              <span class="status-pill">
                <span class="status-dot" /> Available for work
              </span>
            )
          }
        </aside>
      </div>
    </div>
  </section>

  <!-- Toast -->
  <div id="toast" class="toast" role="status" aria-live="polite" hidden>
    <span class="toast__icon"><Icon name="lucide:check" width={18} height={18} /></span>
    <span id="toast-msg"></span>
  </div>
</Layout>

<style>
  .contact {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: clamp(3.5rem, 8vw, 7rem);
  }
  .contact__head h1 {
    margin-top: 0.75rem;
    max-width: 16ch;
  }
  .contact__lede {
    margin-top: 1.5rem;
    max-width: 52ch;
    color: var(--text-2);
    font-size: 1.15rem;
  }
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* Form */
  .form {
    display: grid;
    gap: 1.25rem;
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-1);
  }
  .field input,
  .field textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--text-1);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.75rem 0.875rem;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  .field textarea {
    resize: vertical;
    min-height: 8rem;
  }
  .field--message {
    grid-template-rows: auto minmax(8rem, 1fr) auto;
  }
  .field--message textarea {
    height: 100%;
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .field input[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    border-color: var(--accent);
  }
  .field__error {
    font-size: 0.8rem;
    color: var(--accent);
    min-height: 1rem;
  }
  .field__error:empty {
    display: none;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form__submit {
    justify-self: start;
  }
  .form__submit[disabled] {
    opacity: 0.65;
    cursor: default;
  }
  .form__note {
    font-size: 0.85rem;
    color: var(--text-2);
  }

  /* Direct methods */
  .direct {
    display: grid;
    gap: 1.75rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface-1);
    height: fit-content;
  }
  .direct__label {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-2);
    margin-bottom: 0.4rem;
  }
  .direct__row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .direct__value {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--text-1);
    transition: color 0.15s ease;
  }
  a.direct__value:hover {
    color: var(--accent);
  }
  .direct__socials {
    display: flex;
    gap: 1.25rem;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .copy:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    width: fit-content;
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Toast */
  .toast {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    transform: translate(-50%, 1.5rem);
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    max-width: calc(100vw - 2rem);
    padding: 0.85rem 1.15rem;
    background: var(--text-1);
    color: var(--bg);
    border-radius: var(--r-control);
    box-shadow: var(--shadow-lift);
    font-size: 0.95rem;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .toast.is-error {
    background: var(--danger);
    color: var(--on-accent);
  }
  .toast__icon {
    display: inline-flex;
    color: var(--accent);
    background: var(--bg);
    border-radius: 50%;
    padding: 2px;
  }
  .toast.is-error .toast__icon {
    color: var(--on-accent);
    background: transparent;
    padding: 0;
  }

  @media (min-width: 820px) {
    .contact__grid {
      grid-template-columns: 1.4fr 0.9fr;
    }
  }
</style>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const directCard = document.querySelector<HTMLElement>('.direct');
    const messageField = form.querySelector<HTMLElement>('.field--message');
    const messageInput = form.querySelector<HTMLTextAreaElement>('#message');

    const toast = document.getElementById('toast');
    const toastMsg = document.getElementById('toast-msg');
    const submit = form.querySelector<HTMLButtonElement>('.form__submit');
    let toastTimer: number | undefined;

    const syncMessageHeight = () => {
      if (!directCard || !messageField || !messageInput) return;

      if (!window.matchMedia('(min-width: 820px)').matches) {
        messageField.style.removeProperty('min-height');
        messageField.style.removeProperty('height');
        messageInput.style.removeProperty('height');
        return;
      }

      const cardRect = directCard.getBoundingClientRect();
      const messageRect = messageField.getBoundingClientRect();
      const targetHeight = cardRect.bottom - messageRect.top;
      const finalHeight = Math.max(120, Math.floor(targetHeight));

      messageField.style.minHeight = `${finalHeight}px`;
      messageField.style.height = `${finalHeight}px`;
      messageInput.style.height = '100%';
    };

    syncMessageHeight();
    window.addEventListener('resize', syncMessageHeight);
    window.setTimeout(syncMessageHeight, 120);

    if ('ResizeObserver' in window && directCard) {
      const resizeObserver = new ResizeObserver(syncMessageHeight);
      resizeObserver.observe(directCard);
    }

    const showToast = (msg: string, isError = false) => {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = msg;
      toast.classList.toggle('is-error', isError);
      toast.hidden = false;
      // force reflow so the transition runs
      void toast.offsetWidth;
      toast.classList.add('is-visible');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toast.classList.remove('is-visible');
        window.setTimeout(() => (toast.hidden = true), 300);
      }, 5000);
    };

    const setError = (name: string, msg: string) => {
      const field = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      const input = form.querySelector<HTMLElement>(`[name="${name}"]`);
      if (field) field.textContent = msg;
      if (input) input.setAttribute('aria-invalid', msg ? 'true' : 'false');
    };

    const validate = (data: Record<string, string>) => {
      let firstInvalid: string | null = null;
      const fail = (n: string, m: string) => {
        setError(n, m);
        if (!firstInvalid) firstInvalid = n;
      };
      setError('name', '');
      setError('email', '');
      setError('message', '');
      if (!data.name.trim()) fail('name', 'Please enter your name.');
      if (!data.email.trim()) fail('email', 'Please enter your email.');
      else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)) fail('email', 'That email doesn’t look right.');
      if (!data.message.trim()) fail('message', 'Please add a short message.');
      return firstInvalid;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const data = {
        name: String(fd.get('name') ?? ''),
        email: String(fd.get('email') ?? ''),
        message: String(fd.get('message') ?? ''),
        company: String(fd.get('company') ?? ''), // honeypot
      };

      const firstInvalid = validate(data);
      if (firstInvalid) {
        form.querySelector<HTMLElement>(`[name="${firstInvalid}"]`)?.focus();
        return;
      }

      const original = submit?.textContent ?? 'Send message';
      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }

      try {
            const endpoints = [
                'https://alizain-contact-api.methealizain.workers.dev/api/contact',
                '/api/contact',
                '/api/contact.php'
            ];
        let sent = false;

        for (const endpoint of endpoints) {
          try {
            const res = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data),
            });
            const json = await res.json().catch(() => null);
            if (res.ok && json && json.ok) {
              sent = true;
              break;
            }
          } catch {
            // Try the next endpoint.
          }
        }

        if (sent) {
          form.reset();
          showToast('Thanks — I’ll get back to you soon.');
        } else {
          throw new Error('send failed');
        }
      } catch {
        showToast('Couldn’t send just now — please email methealizain@gmail.com.', true);
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = original;
        }
      }
    });

    // Click-to-copy email
    const copyBtn = document.getElementById('copy-email');
    copyBtn?.addEventListener('click', async () => {
      const value = copyBtn.getAttribute('data-copy') ?? '';
      try {
        await navigator.clipboard.writeText(value);
        showToast('Email copied to clipboard.');
      } catch {
        showToast('Couldn’t copy — please copy it manually.', true);
      }
    });
  }

  document.addEventListener('astro:page-load', initContactForm);
</script>
