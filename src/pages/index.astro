---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import LiveBadge from '../components/LiveBadge.astro';
import CtaBand from '../components/CtaBand.astro';
import AmbientField from '../components/AmbientField.astro';
import VisionShowcase from '../components/VisionShowcase.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../config/site';
import '@fontsource/instrument-serif/latin-400-italic.css';

const services = [
  {
    title: 'LLM apps, RAG and document intelligence',
    desc: 'Chat and search that answer from your own documents, with retrieval and validation tuned until the system stops guessing. The same pipeline turns invoices, statements, and contracts into structured records your software can read.',
    payload: 'retrieval',
  },
  {
    title: 'Agentic workflows',
    desc: 'LangGraph agents that plan, call tools, and finish multi step jobs. Each one ships with schema validation, retries, and a human review path, because an agent without guardrails becomes your problem later.',
    payload: 'guardrails',
  },
  {
    title: 'Python backends with FastAPI',
    desc: 'The unglamorous half, done properly. FastAPI services, Docker images, and AWS pipelines that keep running after the handover call ends.',
    payload: 'service',
  },
  {
    title: 'Machine learning model training',
    desc: 'Supervised models, NLP, and computer vision trained on your own data. When prompting a hosted model will not hold, I label, train, and tune one that will.',
    payload: 'vision',
  },
];

const featuredWork = (
  await getCollection('blog', ({ data }) => data.work && data.featured && !data.draft)
).sort((a, b) => a.data.order - b.data.order);

const lead = featuredWork[0];
const rest = featuredWork.slice(1, 4);
const caseStudyCount = (await getCollection('blog', ({ data }) => data.work && !data.draft)).length;

const heroStats = [
  { value: '70', unit: '%', label: 'manual review removed' },
  { value: '89', unit: '%', label: 'detection accuracy', note: 'mAP@50' },
  { value: '60', unit: '%', label: 'faster document processing' },
  { value: String(caseStudyCount), unit: '', label: 'documented case studies' },
];

const stack = [
  'Python', 'PyTorch', 'OpenAI', 'Anthropic', 'LangChain', 'Ollama' , 'LangGraph', 'FastAPI',
  'YOLOv8', 'OpenCV', 'Docker', 'AWS', 'Fly.io', 'PostgreSQL', 'MongoDB', 'Weaviate', 'FAISS' , 'Scikit-learn',
];

const principles = [
  {
    n: '01',
    title: 'I start on your data, not a demo.',
    desc: 'Week one runs against your real files, including the ugly ones you were going to clean up first.',
  },
  {
    n: '02',
    title: 'If prompting will not hold, I train.',
    desc: 'Some problems are model problems. I would rather label data for two weeks than ship a prompt that fails at 3am.',
  },
  {
    n: '03',
    title: 'You get the runbook, not just the repo.',
    desc: 'Docker image, environment notes, and the failure modes written down, so your team owns it after I leave.',
  },
  {
    n: '04',
    title: 'Numbers get measured after handover.',
    desc: 'A benchmark split in a notebook proves nothing. Every figure here came off a system already in production.',
  },
];

const metrics = [
  {
    value: 70,
    suffix: '%',
    label: 'manual review removed',
    note: 'document pipelines in legal and finance',
    bar: 70,
  },
  {
    value: 89,
    suffix: '%',
    label: 'detection and classification accuracy',
    note: 'YOLOv8 construction safety model, 89 mAP@50',
    bar: 89,
  },
  {
    value: 60,
    suffix: '%',
    label: 'faster document processing',
    note: 'invoices, statements, and timesheets',
    bar: 60,
  },
];

const retrieval = [
  { id: 'contract_v4 · p12', score: '0.94', bar: 94, top: true },
  { id: 'policy_2026 · p3', score: '0.71', bar: 71, top: false },
  { id: 'invoice_terms · p1', score: '0.58', bar: 58, top: false },
  { id: 'faq_export · p8', score: '0.31', bar: 31, top: false },
];

const guardrails = [
  { icon: 'lucide:shield-check', label: 'Tool schemas validated' },
  { icon: 'lucide:refresh-cw', label: 'Retry with fallback model' },
  { icon: 'lucide:user-check', label: 'Human review on low confidence' },
  { icon: 'lucide:history', label: 'Every run logged and replayable' },
];

const endpoints = [
  { method: 'POST', path: '/extract' },
  { method: 'GET', path: '/jobs/{id}' },
  { method: 'POST', path: '/reindex' },
  { method: 'GET', path: '/health' },
];

const detectClasses = ['person', 'helmet', 'vest', 'machinery'];

const smallImage = (src: string) => src.replace(/\.webp$/, '-sm.webp');
---

<Layout
  title="AI Engineer and Python Developer"
  description="Ali Zain (methezain) is an AI engineer and Python developer building LLM apps, RAG systems, and document pipelines that cut manual work in production."
>
  <section class="hero depth-top">
    <AmbientField class="hero__field" density={6400} />
    <div class="container-site hero__body">
      <div class="hero__meta">
        <span class="status-pill">
          <span class="status-pill__dot" aria-hidden="true"></span>
          Available for project work
        </span>
        <span class="hero__role mono-label">AI Engineer · Python Developer · {site.location}</span>
      </div>

      <div class="hero__grid">
        <div class="hero__copy">
          <h1>I build AI systems<br />that do <span class="serif hero__accent">real</span> work.</h1>
          <p class="hero__lede">
            I am Ali Zain. I build retrieval systems, document pipelines, and vision models that go
            into production and stay there. Every number on this page was measured after handover,
            on a client's own data.
          </p>
          <div class="hero__actions">
            <Button href="/contact">
              Start a project
              <Icon name="lucide:arrow-right" width={16} height={16} />
            </Button>
            <Button href="/work" variant="secondary">See the work</Button>
          </div>
        </div>

        <div class="hero__portrait">
          <span class="hero__portrait-hit" aria-hidden="true"></span>
          <div class="hero__portrait-lines" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <img
            class="hero__portrait-img"
            src="/hero-portrait.webp"
            alt="Ali Zain, AI engineer"
            width="452"
            height="881"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>

      <ul class="hero__stats">
        {
          heroStats.map((s) => (
            <li class="hero__stat">
              <span class="stat__value num">
                {s.value}{s.unit && <span class="unit">{s.unit}</span>}
              </span>
              <span class="stat__label">{s.label}</span>
              {s.note && <span class="mono-note hero__stat-note">{s.note}</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="strip" aria-labelledby="stack-label">
    <div class="container-site strip__inner">
      <h2 id="stack-label" class="strip__label mono-label">Tools I ship with</h2>
      <ul class="stack__list">
        {stack.map((t) => <li class="pill">{t}</li>)}
      </ul>
    </div>
  </section>

  <Section id="services" field={9000}>
    <div class="head-split">
      <div>
        <Eyebrow index="01">What I do</Eyebrow>
        <h2>The model, the pipeline, and everything in between.</h2>
      </div>
      <div class="head-split__aside">
        <a href="/services" class="link-quiet">
          All services
          <Icon name="lucide:arrow-right" width={16} height={16} />
        </a>
      </div>
    </div>

    <div class="bento">
      {
        services.map((s, i) => (
          <article
            class:list={['tile', 'lift', `tile--${s.payload}`]}
            data-reveal
            data-reveal-delay={i * 60}
          >
            <div class="tile__text">
              <span class="index-marker">{`//00${i + 1}`}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>

            {
              s.payload === 'retrieval' && (
                <div class="payload" aria-hidden="true">
                  <div class="payload__head">
                    <span class="mono-label">query</span>
                    <span class="mono payload__query">“which clause covers late payment?”</span>
                  </div>
                  <ul class="trace">
                    {retrieval.map((r) => (
                      <li class:list={['trace__row', { 'is-top': r.top }]}>
                        <span class="mono trace__id">{r.id}</span>
                        <span class="trace__track" data-bar={r.bar}><i /></span>
                        <span class="mono trace__score">{r.score}</span>
                      </li>
                    ))}
                  </ul>
                  <p class="mono-label payload__foot">reranked · answer grounded in top match</p>
                </div>
              )
            }

            {
              s.payload === 'guardrails' && (
                <div class="payload payload--flush" aria-hidden="true">
                  <ul class="rows">
                    {guardrails.map((g) => (
                      <li class="rows__item">
                        <span class="rows__icon">
                          <Icon name={g.icon} width={15} height={15} />
                        </span>
                        <span class="mono rows__label">{g.label}</span>
                      </li>
                    ))}
                  </ul>
                  <p class="mono-label payload__foot">state persisted · runs resume where they stop</p>
                </div>
              )
            }

            {
              s.payload === 'service' && (
                <div class="payload payload--flush" aria-hidden="true">
                  <ul class="rows rows--api">
                    {endpoints.map((e) => (
                      <li class="rows__item">
                        <span class="mono rows__method">{e.method}</span>
                        <span class="mono rows__label">{e.path}</span>
                        <span class="mono-label rows__meta">200</span>
                      </li>
                    ))}
                  </ul>
                  <p class="mono-label payload__foot">typed · versioned · health checked</p>
                </div>
              )
            }

            {
              s.payload === 'vision' && (
                <div class="payload payload--vision" aria-hidden="true">
                  <svg class="frame" viewBox="0 0 320 200" role="presentation">
                    <rect x="0.5" y="0.5" width="319" height="199" rx="10" class="frame__plate" />
                    <g class="frame__box">
                      <rect x="52" y="52" width="84" height="132" rx="3" />
                      <text x="52" y="46">person</text>
                    </g>
                    <g class="frame__box frame__box--accent">
                      <rect x="66" y="60" width="56" height="32" rx="3" />
                      <text x="66" y="106">helmet 0.94</text>
                    </g>
                    <g class="frame__box">
                      <rect x="192" y="88" width="102" height="96" rx="3" />
                      <text x="192" y="82">machinery</text>
                    </g>
                    <g class="frame__ticks">
                      <path d="M12 12h14M12 12v14M308 188h-14M308 188v-14" />
                    </g>
                  </svg>
                  <div class="classes">
                    <p class="mono-label classes__head">classes</p>
                    <ul class="classes__list">
                      {detectClasses.map((c) => <li class="pill">{c}</li>)}
                    </ul>
                    <p class="mono-note classes__foot">YOLOv8 · 89 mAP@50</p>
                  </div>
                </div>
              )
            }

          </article>
        ))
      }
    </div>
  </Section>

  <Section id="vision" tone="deep">
    <VisionShowcase />
  </Section>

  <Section id="work" field={11000}>
    <div class="head-bar">
      <div class="head-bar__rail">
        <Eyebrow index="02">Selected work</Eyebrow>
        <a href="/work" class="link-quiet">
          All case studies
          <Icon name="lucide:arrow-right" width={16} height={16} />
        </a>
      </div>
      <h2>Systems shipped, not just notebooks.</h2>
      <p class="head-bar__lede">
        Each of these replaced a queue of manual work, and each one has a written case study behind
        it rather than a screenshot.
      </p>
    </div>

    {
      lead && (
        <a href={`/blog/${lead.slug}`} class="feature card card-interactive lift" data-reveal>
          <div class="feature__visual">
            <img
              src={lead.data.image}
              srcset={`${smallImage(lead.data.image)} 600w, ${lead.data.image} 1200w`}
              sizes="(min-width: 900px) 620px, 100vw"
              alt={lead.data.imageAlt}
              width="1200"
              height="800"
              loading="lazy"
              decoding="async"
            />
            {
              lead.data.client && (
                <span class="feature__chip mono">
                  <span class="mono-label">client</span>
                  {lead.data.client}
                </span>
              )
            }
          </div>
          <div class="feature__body">
            <div class="feature__top">
              <span class="index-marker">//001</span>
              {(lead.data.liveUrl || lead.data.liveLinks?.length) && <LiveBadge />}
            </div>
            <h3>{lead.data.cardTitle ?? lead.data.title}</h3>
            <p>{lead.data.description}</p>
            {lead.data.metric && <p class="feature__metric mono">{lead.data.metric}</p>}
            <ul class="tags">{lead.data.tags.slice(0, 4).map((t) => <li>{t}</li>)}</ul>
            <span class="link-quiet feature__cta">
              Read the case study
              <Icon name="lucide:arrow-right" width={16} height={16} />
            </span>
          </div>
        </a>
      )
    }

    <ol class="worklist">
      {
        rest.map((w, i) => (
          <li data-reveal data-reveal-delay={i * 60}>
            <a href={`/blog/${w.slug}`} class="worklist__link">
              <span class="index-marker worklist__i">{`//00${i + 2}`}</span>
              <span class="worklist__title">{w.data.cardTitle ?? w.data.title}</span>
              <span class="mono worklist__metric">{w.data.metric ?? w.data.category}</span>
              <span class="worklist__arrow" aria-hidden="true">
                <Icon name="lucide:arrow-up-right" width={16} height={16} />
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="results" tone="band" field={8200}>
    <div class="results">
      <div class="results__narrative">
        <Eyebrow index="03">Results</Eyebrow>
        <h2>Numbers that hold up in production.</h2>
        <p class="section-lede">
          Three figures from three shipped systems. Each was measured on the client's own data after
          handover, not on a benchmark split in a notebook.
        </p>

        <figure class="jsonp">
          <figcaption class="jsonp__head">
            <span class="jsonp__dot" aria-hidden="true"></span>
            <span class="mono">results.json</span>
          </figcaption>
          <dl class="jsonp__list">
            <div class="jsonp__row">
              <dt class="mono">invoice_accuracy</dt>
              <dd class="mono num jsonp__figure">98%</dd>
            </div>
            <div class="jsonp__row">
              <dt class="mono">processing_time</dt>
              <dd class="mono num jsonp__figure">−60%</dd>
            </div>
            <div class="jsonp__row">
              <dt class="mono">manual_review</dt>
              <dd class="mono num jsonp__figure">−70%</dd>
            </div>
            <div class="jsonp__row">
              <dt class="mono">deployment</dt>
              <dd class="mono jsonp__text">Docker · AWS · Fly.io</dd>
            </div>
          </dl>
          <div class="jsonp__foot">
            <Icon name="lucide:activity" width={15} height={15} />
            <span>Shipped &amp; monitored in production</span>
          </div>
        </figure>
      </div>

      <div class="results__measures">
        <p class="watermark results__watermark" aria-hidden="true">Results</p>
        <ol class="metrics">
          {
            metrics.map((m, i) => (
              <li class="metric" data-reveal data-reveal-delay={i * 80}>
                <span
                  class="stat__value num metric__figure"
                  data-counter={m.value}
                  data-counter-suffix={m.suffix}
                >
                  {m.value}{m.suffix}
                </span>
                <span class="metric__label">
                  <span class="stat__label">{m.label}</span>
                  <span class="metric__note">{m.note}</span>
                </span>
                <span class="index-marker metric__index">{`//00${i + 1}`}</span>
                <span class="metric__track" data-bar={m.bar}><i /></span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </Section>

  <section class="strip strip--tall" aria-labelledby="principles-label">
    <div class="container-site">
      <h2 id="principles-label" class="strip__label mono-label">How I work</h2>
      <ol class="principles">
        {
          principles.map((p, i) => (
            <li class="principle" data-reveal data-reveal-delay={i * 60}>
              <span class="principle__n mono">{p.n}</span>
              <h3 class="principle__title">{p.title}</h3>
              <p class="principle__desc">{p.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Section id="about-snippet">
    <div class="about">
      <figure class="plate about__plate">
        <img
          src="/profile.webp"
          alt="Ali Zain"
          width="480"
          height="480"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="about__copy">
        <p class="head-statement">
          I like AI that does its job quietly and keeps doing it after I leave.
        </p>
        <p class="about__text">
          Most of my work lands in legal, real estate, and finance, on the problems where documents
          pile up and people burn hours retyping them. When the input is images or messy text instead
          of documents, I train the model rather than prompt one.
        </p>
        <a href="/about" class="link-quiet">
          More about Ali Zain
          <Icon name="lucide:arrow-right" width={16} height={16} />
        </a>
      </div>

      <dl class="rail">
        <div class="rail__row">
          <dt class="mono-label">Based</dt>
          <dd>{site.location}</dd>
        </div>
        <div class="rail__row">
          <dt class="mono-label">Also known as</dt>
          <dd>{site.alternateName}</dd>
        </div>
        <div class="rail__row">
          <dt class="mono-label">Domains</dt>
          <dd>Legal · Real estate · Finance · eCommerce</dd>
        </div>
        <div class="rail__row">
          <dt class="mono-label">Works with</dt>
          <dd>Founders, product teams, agencies</dd>
        </div>
        <div class="rail__row">
          <dt class="mono-label">Engagements</dt>
          <dd>Freelance · Contract</dd>
        </div>
      </dl>
    </div>
  </Section>

  <Section id="cta">
    <CtaBand
      title="Have a workflow worth automating?"
      lede="Tell me what is slow, manual, or breaking at scale. I will tell you what AI can or cannot do realistically about it."
      note="I read every message and usually reply within a day"
    />
  </Section>
</Layout>

<style>
  .hero {
    position: relative;
    padding-top: clamp(1.75rem, 4vw, 3rem);
    padding-bottom: 0;
    overflow: hidden;
  }

  .hero__field {
    -webkit-mask-image: radial-gradient(120% 90% at 70% 30%, #000 15%, transparent 72%);
    mask-image: radial-gradient(120% 90% at 70% 30%, #000 15%, transparent 72%);
  }

  .hero__body {
    position: relative;
    z-index: 1;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding-bottom: var(--s-5);
  }

  .hero__role {
    color: var(--text-2);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    --hero-pad: clamp(1.25rem, 3vw, 2.25rem);
    grid-template-areas: 'copy';
    padding-block: var(--hero-pad);
    border-top: 1px solid var(--border);
  }

  .hero__copy {
    grid-area: copy;
    align-self: start;
  }

  .hero__accent {
    color: var(--accent);
  }

  .hero__lede {
    max-width: 54ch;
    margin-top: var(--s-5);
    color: var(--text-2);
    font-size: 1.0625rem;
    line-height: 1.62;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .hero__actions :global(.btn) {
    min-width: min(12rem, 100%);
  }

  .plate {
    position: relative;
    margin: 0;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .plate img {
    width: 100%;
    height: auto;
    filter: grayscale(0.12) contrast(1.02);
  }

  .hero__portrait {
    grid-area: plate;
    display: none;
    position: relative;
    width: 100%;
    max-width: 340px;
    margin-inline: auto;
  }

  .hero__portrait-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    filter: grayscale(0.7) contrast(1.03) drop-shadow(3px 2px 0 var(--accent));
    transition: filter 0.35s ease;
  }

  .hero__portrait-hit {
    position: absolute;
    top: 20%;
    left: 24%;
    right: 26%;
    bottom: 0;
    z-index: 3;
  }

  .hero__portrait-lines {
    position: absolute;
    z-index: 0;
    top: 55%;
    left: 47%;
    width: 150%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    transform: translate(-50%, -50%) rotate(-32deg);
    pointer-events: none;
  }

  .hero__portrait-lines span {
    display: block;
    width: 65%;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transition: width 0.35s ease;
  }

  .hero__portrait-lines span:nth-child(2) {
    width: 58.5%;
  }

  .hero__portrait-lines span:nth-child(3) {
    width: 52%;
  }

  .hero__portrait-hit:hover ~ .hero__portrait-img {
    filter: grayscale(0.7) contrast(1.03) drop-shadow(7px 4px 0 var(--accent));
  }

  .hero__portrait-hit:hover ~ .hero__portrait-lines span {
    width: 57%;
  }

  .hero__portrait-hit:hover ~ .hero__portrait-lines span:nth-child(2) {
    width: 51%;
  }

  .hero__portrait-hit:hover ~ .hero__portrait-lines span:nth-child(3) {
    width: 45%;
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-5) var(--s-5);
    list-style: none;
    margin: 0;
    padding: clamp(1.5rem, 2.4vw, 2.25rem) 0 clamp(1.75rem, 3vw, 2.75rem);
    border-top: 1px solid var(--border);
  }

  .hero__stat .stat__value {
    font-size: clamp(2rem, 4.4vw, 2.75rem);
  }

  .hero__stat .stat__label {
    margin-top: var(--s-3);
    max-width: 18ch;
  }

  .hero__stat-note {
    display: block;
    margin-top: 0.25rem;
  }

  .strip {
    padding-block: clamp(1.5rem, 2.4vw, 2.25rem);
    border-block: 1px solid var(--border);
  }

  .strip--tall {
    padding-block: clamp(2rem, 3.4vw, 3rem);
  }

  .strip__inner {
    display: grid;
    gap: var(--s-4);
  }

  .strip__label {
    color: var(--text-3);
    font-size: 0.68rem;
  }

  .stack__list {
    display: flex;
    flex-wrap: wrap;
