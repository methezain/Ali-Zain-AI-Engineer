---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import CtaBand from '../components/CtaBand.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import AnswerBlock from '../components/AnswerBlock.astro';
import { site } from '../config/site';
import OrbitMesh from '../components/OrbitMesh.astro';
import { Icon } from 'astro-icon/components';

const services = [
  {
    id: 'documents',
    icon: 'lucide:file-scan',
    title: 'Document and data intelligence',
    line: 'Mixed formats in, structured records out, including the vendor who changed their layout in March.',
    gets: ['OCR + vision extraction', 'Validation layer', 'Writes to your database'],
    removes: 'Retyping files by hand',
  },
  {
    id: 'retrieval',
    icon: 'lucide:search',
    title: 'Retrieval and RAG',
    line: 'Chat and search that answer from your own content, and say nothing when the answer is not in there.',
    gets: ['Chunking + embeddings', 'Reranking', 'Evaluation harness'],
    removes: 'Hunting through folders',
  },
  {
    id: 'agents',
    icon: 'lucide:workflow',
    title: 'Agentic workflows',
    line: 'Multi step jobs an agent finishes on its own, with a human check on the calls that carry risk.',
    gets: ['LangGraph orchestration', 'Typed tool schemas', 'Retries + full logs'],
    removes: 'Copying between five tools',
  },
  {
    id: 'models',
    icon: 'lucide:cpu',
    title: 'Model Training',
    line: 'When prompting a hosted model will not hold, I label your data and train one that will.',
    gets: ['Classification', 'Computer vision', 'Measured on holdout'],
    removes: 'Guessing at edge cases',
  },
  {
    id: 'backend',
    icon: 'lucide:server',
    title: 'Python backends and deployment',
    line: 'The API your product calls, containerised, deployed, and documented well enough to hand over.',
    gets: ['FastAPI + typed schemas', 'Docker + AWS', 'Runbook'],
    removes: 'A notebook nobody can run',
  },
];

const compare = [
  {
    crit: 'Who writes the code',
    cells: [
      { s: 'none', v: 'Me, every line' },
      { s: 'none', v: 'A team you do not pick' },
      { s: 'none', v: 'One person' },
    ],
  },
  {
    crit: 'You talk to whoever is building it',
    cells: [
      { s: 'yes', v: 'Always' },
      { s: 'no', v: 'Through an account manager' },
      { s: 'yes', v: 'Always' },
    ],
  },
  {
    crit: 'Trains a model when prompting will not hold',
    cells: [
      { s: 'yes', v: 'Yes' },
      { s: 'part', v: 'Sometimes' },
      { s: 'no', v: 'Rarely' },
    ],
  },
  {
    crit: 'Runs on your real files in week one',
    cells: [
      { s: 'yes', v: 'Yes' },
      { s: 'part', v: 'After a discovery phase' },
      { s: 'part', v: 'Depends' },
    ],
  },
  {
    crit: 'Runbook and handover included',
    cells: [
      { s: 'yes', v: 'Included' },
      { s: 'part', v: 'Usually an add on' },
      { s: 'no', v: 'Rarely' },
    ],
  },
  {
    crit: 'Several workstreams at once',
    cells: [
      { s: 'no', v: 'No, one project at a time' },
      { s: 'yes', v: 'Yes' },
      { s: 'no', v: 'No' },
    ],
  },
];

const columns = ['Working with me', 'An AI agency', 'A generalist freelancer'];

const routes = [
  {
    k: 'Route A',
    title: 'Discovery, then build',
    when: 'The problem is real but the scope is not settled yet.',
    steps: [
      'A short paid block on your actual files, not a sample set',
      'Ends with a written plan, a working spike, and a fixed scope for the build',
      'If the plan does not convince you, you stop there and keep it',
    ],
  },
  {
    k: 'Route B',
    title: 'Straight to build',
    when: 'You already know what needs to exist.',
    steps: [
      'A call to agree the deliverable and the acceptance test',
      'Build, then handover with the runbook and the failure modes written down',
      'No hourly clock on either side',
    ],
  },
];

const answers = [
  {
    q: 'Who is Ali Zain?',
    a: 'Me. I am an AI engineer and Python developer based in Islamabad, and methezain everywhere online. Since 2024 I have built document extraction pipelines, retrieval systems, and agent workflows that run in production for banking, payroll, legal, and eCommerce teams.',
  },
  {
    q: 'What does an AI engineer actually do?',
    a: 'An AI engineer puts a model inside a system somebody can actually use. That means the retrieval, the validation, the API, the deployment, and the monitoring around the model, not just the call to it. Research picks the approach. An AI engineer makes it survive real traffic.',
  },
  {
    q: 'What is the difference between an AI engineer and an AI/ML engineer?',
    a: 'In practice very little, and I am hired under both titles as well as machine learning engineer. AI engineer usually leans toward LLM systems and retrieval; AI/ML engineer leans toward training and evaluating models. I do both, which is why trained models sits next to retrieval in the list above.',
  },
  {
    q: 'Can I hire Ali Zain as a freelance AI engineer?',
    a: 'Yes. I take project based work alongside my role at Intalytic Group, scoped by deliverable rather than by the hour. Either a short paid discovery block if the scope is unsettled, or straight to a fixed build if you already know what needs to exist.',
  },
  {
    q: 'Which AI engineering services do you offer?',
    a: 'Five: document and data intelligence, retrieval and RAG, agentic workflows, Model Training, and Python backends with deployment. Each one is listed above with what you get and the manual work it removes.',
  },
];

const stages = [
  { name: 'Retrieval augmented generation', tag: 'RAG' },
  { name: 'Agentic AI orchestration', tag: 'Agents' },
  { name: 'Document intelligence', tag: 'OCR + vision' },
  { name: 'Machine learning engineering', tag: 'Training' },
  { name: 'Production APIs and MLOps', tag: 'Deploy' },
];

const marks = {
  yes: { icon: 'lucide:check', label: 'yes' },
  no: { icon: 'lucide:x', label: 'no' },
  part: { icon: 'lucide:minus', label: 'partly' },
};
---

<Layout
  title="AI Engineering Services"
  description="AI engineering services by Ali Zain (methezain): document intelligence, RAG and retrieval, agentic workflows, trained models, and Python backends built for production."
>
  <section class="lead">
    <div class="container-site lead__grid">
      <div class="lead__body">
        <Eyebrow>Services</Eyebrow>
        <h1>Five things I build, and the work each one removes.</h1>
        <p class="lead__text">
          Every one goes into production, runs on your data, and ships with a runbook.
        </p>
        <div class="lead__actions">
          <Button href="/contact">Start a project</Button>
          <a href="/work" class="link-quiet">
            See what shipped
            <Icon name="lucide:arrow-right" width={16} height={16} />
          </a>
        </div>
      </div>

      <div class="rig">
        <span class="streaks" aria-hidden="true">
          <i style="--y: 8%; --d: 0s; --t: 2.6s"></i>
          <i style="--y: 21%; --d: 0.9s; --t: 3.4s"></i>
          <i style="--y: 34%; --d: 1.7s; --t: 2.2s"></i>
          <i style="--y: 52%; --d: 0.4s; --t: 3s"></i>
          <i style="--y: 68%; --d: 2.1s; --t: 2.8s"></i>
          <i style="--y: 84%; --d: 1.3s; --t: 3.6s"></i>
        </span>

        <ol class="stack">
          {
            stages.map((st, i) => (
              <li
                class:list={['stage', { 'stage--lit': i === 0 }]}
                style={`--i: ${i}`}
              >
                <span class="stage__n mono-label">{`0${i + 1}`}</span>
                <span class="stage__name">{st.name}</span>
                <span class="stage__tag mono-label">{st.tag}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <Section id="offer">
    <div class="section-head">
      <Eyebrow index="01">What I build</Eyebrow>
      <h2>One engineer, five systems.</h2>
    </div>

    <div class="hub" data-hub>
      <svg class="hub__wires" aria-hidden="true" data-hub-wires preserveAspectRatio="none"></svg>

      <div class="hub__core" data-hub-core>
        <span class="hub__mark" aria-hidden="true">
          <Icon name="lucide:terminal" width={20} height={20} />
        </span>
        <span class="hub__name">{site.name}</span>
        <span class="hub__role mono-label">AI Engineer · Python Developer</span>
      </div>

      <ol class="hub__list">
        {
          services.map((sv, i) => (
            <li>
              <a
                class="node"
                id={sv.id}
                href={`/contact?service=${sv.id}`}
                data-hub-node={sv.id}
              >
                <span class="node__icon" aria-hidden="true">
                  <Icon name={sv.icon} width={17} height={17} />
                </span>
                <span class="node__body">
                  <span class="node__title">{sv.title}</span>
                  <span class="node__line">{sv.line}</span>
                  <span class="node__gets">
                    {sv.gets.map((g) => <span class="pill">{g}</span>)}
                  </span>
                  <span class="node__removes">
                    <span class="mono-label">Removes</span>
                    {sv.removes}
                  </span>
                </span>
                <span class="node__n index-marker" aria-hidden="true">{`0${i + 1}`}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <Section id="trained" tone="deep">
    <div class="mind">
      <figure class="mind__art">
        <OrbitMesh class="mind__globe" points={88} />
        <img
          src="/services/brain.webp"
          srcset="/services/brain-sm.webp 560w, /services/brain.webp 1100w"
          sizes="(min-width: 900px) 460px, 90vw"
          alt="A brain rendered as a circuit board, standing for a model trained on your own data"
          width="1100"
          height="963"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="mind__copy">
        <p class="head-statement">
          A prompt borrows somebody else’s judgement. A trained model learns yours.
        </p>
        <p class="mind__text">
          Hosted models are the right answer most of the time, and I reach for them first. But when
          the decision depends on how <em>your</em> business reads a document, no amount of prompt
          wording fixes it. That is when I label your data and train something that does.
        </p>
        <a href="#models" class="link-quiet">
          Model Training
          <Icon name="lucide:arrow-up" width={16} height={16} />
        </a>
      </div>
    </div>
  </Section>

  <Section id="compare" tone="band">
    <div class="section-head">
      <Eyebrow index="02">The honest version</Eyebrow>
      <h2>One engineer is not always the right answer.</h2>
      <p class="section-lede">
        There are real reasons to hire an agency instead. Here is where each option actually wins, so
        you can rule me out quickly if I am the wrong shape.
      </p>
    </div>

    <div class="cmp-scroll">
      <table class="cmp">
        <caption class="sr-only">
          Comparing an independent engineer, an AI agency, and a generalist freelancer
        </caption>
        <thead>
          <tr>
            <th scope="col" class="mono-label">Criterion</th>
            {columns.map((c) => <th scope="col" class="mono-label cmp__col">{c}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            compare.map((row) => (
              <tr>
                <th scope="row" class="cmp__crit">{row.crit}</th>
                {row.cells.map((cell) => (
                  <td class="cmp__cell">
                    <span class:list={['cmp__val', `cmp__val--${cell.s}`]}>
                      {cell.s !== 'none' && (
                        <Icon name={marks[cell.s].icon} width={14} height={14} aria-hidden="true" />
                      )}
                      {cell.s !== 'none' && <span class="sr-only">{marks[cell.s].label}, </span>}
                      {cell.v}
                    </span>
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="cmp__hint mono-note">Scroll the table sideways to compare all three.</p>
  </Section>

  <Section id="routes">
    <div class="head-split">
      <div>
        <Eyebrow index="03">Getting started</Eyebrow>
        <h2>You do not have to know the scope before we start.</h2>
      </div>
      <div class="head-split__aside">
        <a href="/contact" class="link-quiet">
          Send me the problem
          <Icon name="lucide:arrow-right" width={16} height={16} />
        </a>
      </div>
    </div>

    <div class="routes">
      {
        routes.map((r) => (
          <article class="route" data-reveal>
            <span class="mono-label route__k">{r.k}</span>
            <h3>{r.title}</h3>
            <p class="route__when">{r.when}</p>
            <ol class="route__steps">
              {r.steps.map((st) => <li>{st}</li>)}
            </ol>
          </article>
        ))
      }
    </div>

    <p class="routes__foot mono-note">
      Either way: project based, scoped by deliverable, no hourly commitment.
    </p>
  </Section>

  <Section id="answers">
    <div class="faq">
      <Eyebrow index="04">Before you email</Eyebrow>
      <AnswerBlock title="Common questions about hiring an AI engineer" items={answers} />
    </div>
  </Section>

  <Section id="svc-cta">
    <CtaBand
      title="Not sure which of the five you need?"
      lede="Describe what is slow or manual and send one real file. I will tell you which of these fits, or that none of them do."
      note="Project based · I reply within a day"
    />
  </Section>
</Layout>

<script>
  const SVG = 'http://www.w3.org/2000/svg';

  const drawWires = (hub: HTMLElement) => {
    const svg = hub.querySelector<SVGSVGElement>('[data-hub-wires]');
    const core = hub.querySelector<HTMLElement>('[data-hub-core]');
    const nodes = [...hub.querySelectorAll<HTMLElement>('[data-hub-node]')];
    if (!svg || !core || !nodes.length) return;

    const box = hub.getBoundingClientRect();
    svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
    svg.setAttribute('width', String(box.width));
    svg.setAttribute('height', String(box.height));
    svg.replaceChildren();

    // Below the two-column breakpoint the cards stack, so the wires would cross the text.
    if (!window.matchMedia('(min-width: 1000px)').matches) return;

    const c = core.getBoundingClientRect();
    const hx = c.right - box.left;
    const hy = c.top + c.height / 2 - box.top;
    const R = 16;

    nodes.forEach((node, i) => {
      const n = node.getBoundingClientRect();
      const nx = n.left - box.left;
      const ny = n.top + n.height / 2 - box.top;
      const midX = hx + (nx - hx) * 0.45;
      const dir = ny > hy ? 1 : -1;
      const d =
        Math.abs(ny - hy) < R * 2
          ? `M ${hx} ${hy} H ${nx}`
          : `M ${hx} ${hy} H ${midX - R} Q ${midX} ${hy} ${midX} ${hy + R * dir}` +
            ` V ${ny - R * dir} Q ${midX} ${ny} ${midX + R} ${ny} H ${nx}`;

      const base = document.createElementNS(SVG, 'path');
      base.setAttribute('d', d);
      base.setAttribute('class', 'wire');
      base.setAttribute('fill', 'none');
      svg.appendChild(base);

      const lit = document.createElementNS(SVG, 'path');
      lit.setAttribute('d', d);
      lit.setAttribute('class', 'wire wire--lit');
      lit.setAttribute('fill', 'none');
      lit.dataset.wireFor = node.dataset.hubNode ?? '';
      lit.style.setProperty('--wire-delay', `${i * 0.62}s`);
      svg.appendChild(lit);

      const dot = document.createElementNS(SVG, 'circle');
      dot.setAttribute('r', '2.5');
      dot.setAttribute('cx', String(nx));
      dot.setAttribute('cy', String(ny));
      dot.setAttribute('class', 'wire__cap');
      svg.appendChild(dot);
    });
  };

  const boot = () => {
    document.querySelectorAll<HTMLElement>('[data-hub]').forEach((hub) => {
      const paint = () => drawWires(hub);
      paint();

      let t = 0;
      const onResize = () => {
        window.clearTimeout(t);
        t = window.setTimeout(paint, 120);
      };
      window.addEventListener('resize', onResize, { passive: true });
      window.matchMedia('(min-width: 1000px)').addEventListener('change', paint);
      if (document.fonts?.ready) document.fonts.ready.then(paint);

      const light = (id: string | null) => {
        hub.querySelectorAll<SVGPathElement>('[data-wire-for]').forEach((p) => {
          p.classList.toggle('is-lit', p.dataset.wireFor === id);
        });
      };

      hub.querySelectorAll<HTMLElement>('[data-hub-node]').forEach((node) => {
        const on = () => light(node.dataset.hubNode ?? null);
        const off = () => light(null);
        node.addEventListener('pointerenter', on);
        node.addEventListener('focus', on);
        node.addEventListener('pointerleave', off);
        node.addEventListener('blur', off);
      });
    });
  };

  boot();
  document.addEventListener('astro:after-swap', boot);
</script>



<style>
  .lead {
    padding-top: clamp(1.75rem, 4vw, 3rem);
    padding-bottom: clamp(1.75rem, 3.4vw, 2.75rem);
    overflow: hidden;
  }

  .lead__grid {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .rig {
    position: relative;
    width: 100%;
  }

  .stack {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stage {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-3);
    padding: 0.8125rem 0.9375rem;
    border: 1px solid var(--border);
    border-radius: var(--r-control);
    background: var(--surface-1);
    transition:
      background var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .stage__n {
    color: var(--text-3);
  }

  .stage__name {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.012em;
    color: var(--text-1);
  }

  .stage__tag {
    color: var(--text-3);
  }

  /* The lit stage: an accent fill, not a neon halo. The tinted drop is
     directional so it reads as elevation rather than bloom. */
  .stage--lit {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 10px 26px -12px color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .stage--lit .stage__n,
  .stage--lit .stage__tag {
    color: color-mix(in srgb, var(--on-accent) 70%, transparent);
  }

  .stage--lit .stage__name {
    color: var(--on-accent);
  }

  .streaks {
    display: none;
  }

  .lead__body {
    position: relative;
    z-index: 1;
  }

  .lead h1 {
    margin-top: 0.875rem;
    max-width: 22ch;
  }

  .lead__text {
    margin-top: var(--s-5);
    max-width: 46ch;
    color: var(--text-2);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .lead__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-5);
    margin-top: clamp(1.5rem, 2.6vw, 2rem);
  }

  .item__removes .mono-label {
    color: var(--text-3);
  }

  :global(#trained) {
    overflow: hidden;
    padding-block: clamp(5rem, 8vw, 7rem);
  }

  .mind {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
  }

  .mind__art img {
    width: 100%;
    height: auto;
    opacity: 0.92;
  }

  .mind__text {
    margin: var(--s-5) 0;
    max-width: 54ch;
    color: var(--text-2);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .mind__text em {
    font-style: normal;
    color: var(--text-1);
  }

  .section-head :global(.section-lede) {
    max-width: 58ch;
  }

  .cmp-scroll {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  .cmp {
    width: 100%;
    min-width: 680px;
    border-collapse: collapse;
    text-align: left;
  }

  .cmp thead th {
    padding: 0 var(--s-4) var(--s-3) 0;
    color: var(--text-3);
    font-weight: 500;
    vertical-align: bottom;
    border-bottom: 1px solid var(--border-strong);
  }

  .cmp tbody th,
  .cmp tbody td {
    padding: var(--s-4) var(--s-4) var(--s-4) 0;
    border-bottom: 1px solid var(--border);
    vertical-align: baseline;
  }

  .cmp__crit {
    width: 30%;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-1);
  }

  .cmp__val {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 0.9375rem;
    color: var(--text-2);
  }

  .cmp__val svg {
    flex: none;
    transform: translateY(2px);
  }

  .cmp__val--yes {
    color: var(--text-1);
  }

  .cmp__val--yes svg {
    color: var(--accent-hover);
  }

  .cmp__val--no svg,
  .cmp__val--part svg {
    color: var(--text-3);
  }

  .cmp__hint {
    margin: var(--s-4) 0 0;
    color: var(--text-3);
  }

  .routes {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  .route {
    padding-top: var(--s-4);
    border-top: 1px solid var(--border-strong);
  }

  .route__k {
    color: var(--accent);
  }

  .route h3 {
    margin: 0.5rem 0 0;
    font-size: 1.1875rem;
  }

  .route__when {
    margin: 0.375rem 0 0;
    max-width: 40ch;
    color: var(--text-3);
    font-size: 0.875rem;
  }

  .route__steps {
    display: grid;
    gap: var(--s-3);
    margin: var(--s-5) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .route__steps li {
    position: relative;
    max-width: 44ch;
    padding-left: 1.75rem;
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.55;
    counter-increment: step;
  }

  .route__steps li::before {
    content: counter(step);
    position: absolute;
    top: 0;
    left: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--accent);
  }

  .routes__foot {
    margin: var(--s-6) 0 0;
    padding-top: var(--s-4);
    border-top: 1px solid var(--border);
  }

  .faq {
    max-width: 780px;
  }

  .faq :global(.answer-block h2) {
    margin-top: 0.75rem;
  }

  .faq :global(.answer-block__list) {
    gap: 0;
